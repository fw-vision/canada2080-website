<!--
  This client-side gate is a pre-launch presentation curtain, not authentication.
  Static HTML and the access code remain inspectable in the browser source.
-->

<div class="access-gate-wrapper" id="access-gate" role="dialog" aria-modal="true" aria-labelledby="access-title">
  <div class="access-gate">
    <p class="eyebrow">Private preview / Canada2080</p>
    <h1 id="access-title">Enter the preview.</h1>
    <p class="access-description">This working site is available to invited reviewers before public release.</p>

    <form class="access-form" id="access-form" autocomplete="off" novalidate>
      <label class="access-label" for="access-code-input">Four-digit access code</label>
      <input
        id="access-code-input"
        name="access-code"
        type="password"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="4"
        autocomplete="off"
        required
        aria-describedby="access-status"
      />
      <p id="access-status" class="access-status" role="status" aria-live="polite"></p>
      <button type="submit" class="access-button">Enter preview</button>
    </form>

    <noscript>
      <p class="noscript-message">This preview curtain requires JavaScript. Enable JavaScript to continue.</p>
    </noscript>
  </div>
</div>

<button class="lock-preview-button" id="lock-preview" type="button">Lock preview</button>

<script is:inline>
  (() => {
    const key = 'canada2080.preview.access';
    const expectedCode = '2080';
    const root = document.documentElement;
    const gate = document.getElementById('access-gate');
    const form = document.getElementById('access-form');
    const input = document.getElementById('access-code-input');
    const status = document.getElementById('access-status');
    const lockButton = document.getElementById('lock-preview');

    let memoryAccess = root.classList.contains('preview-unlocked');

    const persist = (granted) => {
      memoryAccess = granted;
      try {
        if (granted) localStorage.setItem(key, 'granted');
        else localStorage.removeItem(key);
        return;
      } catch {}

      try {
        if (granted) sessionStorage.setItem(key, 'granted');
        else sessionStorage.removeItem(key);
      } catch {}
    };

    const unlock = () => {
      persist(true);
      root.classList.add('preview-unlocked');
      gate?.setAttribute('aria-hidden', 'true');
      lockButton?.focus();
    };

    const lock = () => {
      persist(false);
      root.classList.remove('preview-unlocked');
      gate?.removeAttribute('aria-hidden');
      if (input instanceof HTMLInputElement) input.value = '';
      if (status) status.textContent = '';
      input?.focus();
    };

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(input instanceof HTMLInputElement)) return;

      if (input.value.trim() === expectedCode) {
        unlock();
        return;
      }

      input.setAttribute('aria-invalid', 'true');
      if (status) status.textContent = 'That code was not recognised. Try again.';
      input.select();
    });

    input?.addEventListener('input', () => {
      input.removeAttribute('aria-invalid');
      if (status) status.textContent = '';
    });

    lockButton?.addEventListener('click', lock);

    if (memoryAccess) unlock();
    else input?.focus();
  })();
</script>

<style>
  .access-gate-wrapper {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    overflow-y: auto;
    padding: 1.25rem;
    background-color: var(--paper);
    background-image: radial-gradient(circle at 1px 1px, rgb(36 31 28 / 14%) 1px, transparent 0);
    background-size: 12px 12px;
  }

  .access-gate {
    width: min(100%, 32rem);
    padding: clamp(2rem, 7vw, 4rem);
    border: 1px solid var(--line);
    background: var(--paper-strong);
  }

  .access-gate h1 {
    margin: 1rem 0 1.25rem;
    font-size: clamp(2.75rem, 10vw, 5rem);
  }

  .access-description {
    color: var(--ink-muted);
  }

  .access-form {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .access-label {
    font: 0.68rem/1.4 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #access-code-input {
    width: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
    font: 1.25rem/1 var(--mono);
    letter-spacing: 0.35em;
  }

  #access-code-input[aria-invalid='true'] {
    border-color: var(--rust);
  }

  .access-status {
    min-height: 1.25rem;
    margin: 0;
    color: var(--rust);
    font-size: 0.82rem;
  }

  .access-button {
    padding: 1rem 1.25rem;
    border: 1px solid var(--aubergine);
    border-radius: 2px;
    background: var(--aubergine);
    color: var(--paper);
    cursor: pointer;
    font: 0.72rem/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .access-button:hover {
    background: var(--aubergine-soft);
  }

  .noscript-message {
    margin-top: 1.5rem;
    color: var(--rust);
  }

  .lock-preview-button {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 900;
    display: none;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--line);
    background: rgb(244 240 230 / 88%);
    color: var(--ink-muted);
    cursor: pointer;
    font: 0.62rem/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(html:not(.preview-unlocked) .protected-site) {
    visibility: hidden;
  }

  :global(html.preview-unlocked .access-gate-wrapper) {
    display: none;
  }

  :global(html.preview-unlocked .lock-preview-button) {
    display: block;
  }
</style>
