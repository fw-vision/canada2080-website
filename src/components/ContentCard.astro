---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  linkLabel?: string;
}

const { eyebrow, title, description, href, linkLabel = 'Read more' } = Astro.props;
---

<article class="content-card">
  <p class="eyebrow">{eyebrow}</p>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">↗</span></a>
</article>
