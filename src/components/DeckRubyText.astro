---
import { isDeckRuby, type DeckRichText } from '../data/kickoffDeck';

interface Props {
  parts: DeckRichText;
}

const { parts } = Astro.props;
---

{
  parts.map((part) =>
    isDeckRuby(part) ? (
      <ruby class="deck-ruby">
        {part.base}
        <rp> (</rp>
        <rt aria-hidden="true">{part.reading}</rt>
        <rp>)</rp>
      </ruby>
    ) : (
      part
    ),
  )
}
