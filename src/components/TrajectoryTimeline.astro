---
import { trajectory } from '../data/site';
---

<ol class="trajectory-list">
  {trajectory.map((phase, index) => (
    <li>
      <span class="trajectory-index" aria-hidden="true">0{index + 1}</span>
      <p class="trajectory-years">{phase.years}</p>
      <h3>{phase.title}</h3>
      <p>{phase.summary}</p>
    </li>
  ))}
</ol>
