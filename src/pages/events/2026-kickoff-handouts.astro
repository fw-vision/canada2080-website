---
import YearWordmark from '../../components/YearWordmark.astro';
import {
  handoutAiReflection,
  handoutContributorSets,
  handoutMeta,
  handoutPanels,
  handoutProgrammeGlance,
  handoutReceptionQuestions,
} from '../../data/kickoffHandout';
import '../../styles/global.css';
import '../../styles/kickoff-handout.css';

const pageTitle = 'Kickoff handout | Canada2080';
const pageDescription =
  'Letter-size Canada2080 kickoff take-home packet with talking points, note space, and reflection questions.';
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={new URL('/events/2026-kickoff-handouts', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body class="handout-body">
    <header class="handout-chrome">
      <p>Canada2080 kickoff · letter handout · take home, write in, keep working</p>
      <div class="handout-chrome-actions">
        <button type="button" onclick="window.print()">Print letter</button>
        <a class="secondary" href="/events/2026-kickoff">Event page</a>
        <a class="secondary" href="/">canada2080.org</a>
      </div>
    </header>

    <main class="handout-stack" id="main-content">
      <section class="handout-sheet handout-cover" aria-label="Handout page 1 of 8">
        <div class="handout-cover-top">
          <div>
            <p class="handout-kicker">{handoutMeta.date} · Markham</p>
            <h1 class="handout-title">{handoutMeta.title}</h1>
            <p class="handout-launch-line">
              Actualizing an abundant, resilient, sustainable, and sovereign future for Canada.
            </p>
          </div>
          <div class="handout-wordmark" aria-hidden="true">
            <YearWordmark tone="default" />
          </div>
        </div>

        <p class="handout-throughline">{handoutMeta.throughline}</p>

        <dl class="handout-meta-grid">
          <dt>When</dt>
          <dd>{handoutMeta.date} · {handoutMeta.time}</dd>
          <dt>Where</dt>
          <dd>{handoutMeta.venue}</dd>
          <dt>Address</dt>
          <dd>{handoutMeta.address}</dd>
          <dt>Continue</dt>
          <dd>{handoutMeta.site}</dd>
        </dl>

        <div class="handout-fill-grid" aria-label="Your details">
          <div class="handout-fill-row"><span>Name</span></div>
          <div class="handout-fill-row"><span>Organisation</span></div>
          <div class="handout-fill-row"><span>Role</span></div>
        </div>

        <div class="handout-cover-statement">
          <p>The long horizon has a present tense.</p>
          <span>Listen · test · contribute · continue</span>
        </div>

        <footer class="handout-footer">
          <span>01 / 08 · Cover</span>
          <span>{handoutMeta.subtitle}</span>
        </footer>
      </section>

      <section class="handout-sheet" aria-label="Handout page 2 of 8">
        <p class="handout-kicker">Programme map</p>
        <h2 class="handout-section-title">The afternoon at a glance</h2>
        <ul class="handout-glance handout-glance-full">
          {
            handoutProgrammeGlance.map((item) => (
              <li>
                <strong>{item.time}</strong>
                <span>
                  {item.title}
                  <small>{item.duration}</small>
                </span>
              </li>
            ))
          }
        </ul>

        <div class="handout-role-grid">
          <article>
            <span>Host</span>
            <strong>{handoutMeta.host.name}</strong>
            <p>{handoutMeta.host.affiliation}</p>
            <a href={handoutMeta.host.profileUrl}>linkedin.com/in/findcongwang</a>
          </article>
          <article>
            <span>Co-host</span>
            <strong>{handoutMeta.coHost.name}</strong>
            <p>{handoutMeta.coHost.affiliation}</p>
          </article>
          <article>
            <span>Master of ceremonies</span>
            <strong>{handoutMeta.mc}</strong>
            <p>Introductions, handoffs, panel questions, and timekeeping</p>
            <a href={handoutMeta.mcProfileUrl}>linkedin.com/in/kritika-saihgpaul</a>
          </article>
        </div>

        <div class="handout-mini-notes">
          <p class="handout-prompt">What do I want to listen for today?</p>
          <div class="handout-note-lines" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        </div>

        <footer class="handout-footer">
          <span>02 / 08 · Programme</span>
          <span>{handoutMeta.site}</span>
        </footer>
      </section>

      <section class="handout-sheet" aria-label="Handout page 3 of 8">
        <p class="handout-kicker">{handoutContributorSets[0].label}</p>
        <h2 class="handout-section-title">
          {handoutContributorSets[0].titleLines.map((line) => <span>{line}</span>)}
        </h2>

        <div class="handout-contributors">
          {
            handoutContributorSets[0].contributors.map((person) => (
              <article class="handout-contributor">
                <header>
                  <div>
                    <h3>{person.name}</h3>
                    <p>{person.affiliation}</p>
                  </div>
                  <span>{person.attendance === 'remote' ? 'Remote' : 'In person'}</span>
                </header>
                <p>{person.bio}</p>
                <p class="handout-topic"><strong>Contribution:</strong> {person.topic}</p>
              </article>
            ))
          }
        </div>

        <footer class="handout-footer">
          <span>03 / 08 · Contributors</span>
          <span>Set 1</span>
        </footer>
      </section>

      <section class="handout-sheet" aria-label="Handout page 4 of 8">
        <p class="handout-kicker">Panel 1 discussion guide</p>
        <h2 class="handout-section-title">
          {handoutPanels[0].titleLines.map((line) => <span>{line}</span>)}
        </h2>
        <p class="handout-lead">{handoutPanels[0].purpose}</p>

        <ol class="handout-panel-questions">
          {
            handoutPanels[0].questions.map((item, index) => (
              <li>
                <span class:list={['handout-question-kind', item.kind === 'primary' ? 'is-primary' : 'is-backup']}>
                  {item.kind === 'primary' ? 'Primary' : 'Backup'} {index + 1}
                </span>
                <p><strong>{item.label}:</strong> {item.question}</p>
              </li>
            ))
          }
        </ol>

        <div class="handout-writing-block">
          {handoutPanels[0].writingPrompts.map((prompt) => <p>{prompt}</p>)}
          <div class="handout-note-lines" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>

        <footer class="handout-footer">
          <span>04 / 08 · Panel 1</span>
          <span>Private notes</span>
        </footer>
      </section>

      <section class="handout-sheet" aria-label="Handout page 5 of 8">
        <p class="handout-kicker">{handoutContributorSets[1].label}</p>
        <h2 class="handout-section-title">
          {handoutContributorSets[1].titleLines.map((line) => <span>{line}</span>)}
        </h2>

        <div class="handout-contributors">
          {
            handoutContributorSets[1].contributors.map((person) => (
              <article class="handout-contributor">
                <header>
                  <div>
                    <h3>{person.name}</h3>
                    <p>{person.affiliation}</p>
                  </div>
                  <span>{person.attendance === 'remote' ? 'Remote' : 'In person'}</span>
                </header>
                <p>{person.bio}</p>
                <p class="handout-topic"><strong>Contribution:</strong> {person.topic}</p>
              </article>
            ))
          }
        </div>

        <footer class="handout-footer">
          <span>05 / 08 · Contributors</span>
          <span>Set 2</span>
        </footer>
      </section>

      <section class="handout-sheet" aria-label="Handout page 6 of 8">
        <p class="handout-kicker">Panel 2 discussion guide</p>
        <h2 class="handout-section-title">
          {handoutPanels[1].titleLines.map((line) => <span>{line}</span>)}
        </h2>
        <p class="handout-lead">{handoutPanels[1].purpose}</p>

        <ol class="handout-panel-questions">
          {
            handoutPanels[1].questions.map((item, index) => (
              <li>
                <span class:list={['handout-question-kind', item.kind === 'primary' ? 'is-primary' : 'is-backup']}>
                  {item.kind === 'primary' ? 'Primary' : 'Backup'} {index + 1}
                </span>
                <p><strong>{item.label}:</strong> {item.question}</p>
              </li>
            ))
          }
        </ol>

        <div class="handout-writing-block">
          {handoutPanels[1].writingPrompts.map((prompt) => <p>{prompt}</p>)}
          <div class="handout-note-lines" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
          </div>
        </div>

        <footer class="handout-footer">
          <span>06 / 08 · Panel 2</span>
          <span>Private notes</span>
        </footer>
      </section>

      <section class="handout-sheet" aria-label="Handout page 7 of 8">
        <p class="handout-kicker">Compute reflection</p>
        <h2 class="handout-section-title">{handoutAiReflection.title}</h2>
        <p class="handout-lead">{handoutAiReflection.instruction}</p>

        <ol class="handout-reflection-list">
          {
            handoutAiReflection.prompts.map((prompt) => (
              <li>
                <p>{prompt.question}</p>
                {prompt.options.length > 0 ? (
                  <div class="handout-checks">
                    {prompt.options.map((option) => <span>□ {option}</span>)}
                  </div>
                ) : (
                  <div class="handout-note-lines" aria-hidden="true">
                    <span></span><span></span>
                  </div>
                )}
              </li>
            ))
          }
        </ol>

        <aside class="handout-supporters">
          <strong>Supporters of the Canada2080 initiative</strong>
          <div>
            {
              handoutAiReflection.supporters.map((supporter) => (
                <a href={supporter.href}>
                  <b>{supporter.name}</b>
                  <span>{supporter.website}</span>
                </a>
              ))
            }
          </div>
        </aside>

        <footer class="handout-footer">
          <span>07 / 08 · Personal reflection</span>
          <span>Not collected</span>
        </footer>
      </section>

      <section class="handout-sheet" aria-label="Handout page 8 of 8">
        <p class="handout-kicker">Networking follow-up</p>
        <h2 class="handout-section-title">Questions to carry into networking</h2>

        <div class="handout-reception-prompts">
          {
            handoutReceptionQuestions.map((question, index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{question}</p>
                <div class="handout-note-lines" aria-hidden="true">
                  <span></span><span></span><span></span>
                </div>
              </article>
            ))
          }
        </div>

        <div class="handout-final-line">
          <strong>One next conversation</strong>
          <span>With whom?</span>
          <span>By when?</span>
        </div>

        <footer class="handout-footer">
          <span>08 / 08 · Continue</span>
          <span>canada2080.org · #canada2080</span>
        </footer>
      </section>
    </main>
  </body>
</html>
