---
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Canada2080 启动活动邀请卡片，2026年10月4日星期日。"
    />
    <meta name="robots" content="noindex" />
    <title>Canada2080 启动活动邀请卡片</title>
  </head>
  <body>
    <main class="deck" aria-label="Canada2080 启动活动邀请卡片">
      <div class="card-slot">
        <article class="card card-cover" aria-labelledby="cover-title">
          <div class="cover-media" aria-hidden="true">
            <img
              class="cover-photo"
              src="/images/hero/toronto-lake.jpg"
              alt=""
              width="2400"
              height="1600"
            />
            <div class="cover-veil"></div>
          </div>

          <div class="cover-content">
            <header class="cover-brand">
              <img
                class="cover-wordmark"
                src="/brand/2080-wordmark.svg"
                alt="Canada2080"
                width="894"
                height="221"
              />
              <p class="cover-mark">启动发布会</p>
            </header>

            <div class="cover-body">
              <div class="signal-rule" aria-hidden="true"></div>
              <h1 id="cover-title">
                <span>共同建设一个丰盛、</span>
                <span>坚韧、可持续、</span>
                <span>由加拿大自主掌握的未来。</span>
              </h1>
              <p class="cover-deck">
                到2080年，<br />
                加拿大将成为世界主要经济强国之一。<br />
                凭借在本土建设的主权产业、<br />
                科研、资本与公共价值，<br />
                加拿大将具备超越美国的能力。
              </p>
            </div>

            <footer class="cover-details">
              <div class="cover-grid">
                <div class="cover-detail">
                  <span class="meta">日期</span>
                  <strong>2026年10月4日，星期日</strong>
                </div>
                <div class="cover-detail cover-detail-venue">
                  <span class="meta">场地</span>
                  <strong>Hilton Toronto/Markham Suites<br />Conference Centre &amp; Spa</strong>
                  <strong class="cover-detail-sub">Markham Ballroom</strong>
                  <span class="cover-detail-address">8500 Warden Ave.,<br />Markham, ON L6G 1A5</span>
                </div>
                <div class="cover-detail">
                  <span class="meta">参与方式</span>
                  <strong>现场与线上均可。</strong>
                  <strong class="cover-detail-sub">具体时间将于周日晚上或周一公布。</strong>
                </div>
              </div>
              <div class="cover-bottom">
                <p class="cover-site">canada2080.org</p>
              </div>
            </footer>
          </div>
        </article>
      </div>

      <div class="card-slot">
        <article class="card card-guests" aria-labelledby="guests-title">
          <header class="card-topline">
            <img
              class="topline-wordmark topline-wordmark-ink"
              src="/brand/2080-wordmark-ink.svg"
              alt="Canada2080"
              width="894"
              height="221"
            />
            <p class="card-kicker">受邀嘉宾</p>
          </header>

          <div class="guests-cluster">
            <div class="guests-main">
              <h2 id="guests-title">
                <span>治理、教育与产业，</span>
                <span class="guests-title-final">共同建设加拿大未来。</span>
              </h2>
              <div class="guest-columns">
                <section aria-labelledby="guests-public">
                  <h3 id="guests-public">治理<br />市政领导者</h3>
                  <ul>
                    <li>Frank Scarpitti</li>
                    <li>Alan Ho</li>
                    <li>Shaun Chen</li>
                  </ul>
                </section>
                <section aria-labelledby="guests-research">
                  <h3 id="guests-research">教育<br />科研领导者</h3>
                  <ul>
                    <li>Barry Wylant</li>
                    <li>Larry Smith</li>
                    <li>Prof Jay Gonzalez</li>
                    <li>Erin Trochim</li>
                    <li>Kimberly Yazzie</li>
                  </ul>
                </section>
                <section aria-labelledby="guests-capability">
                  <h3 id="guests-capability">产业<br />创新领导者</h3>
                  <ul>
                    <li>Pyn Lim</li>
                    <li>Himanshu Joshi</li>
                    <li>Yulia Korobkova</li>
                    <li>Diarmuid Nash</li>
                    <li>Michael Donaldson</li>
                  </ul>
                </section>
              </div>
            </div>

            <div class="guest-further">
              <p class="guest-further-label">其他受邀生态系统参与者</p>
              <p class="guest-further-names">
                Greg Hart · Jeff Clune · Dr Marc Hurwitz · Matti Siemiatycki ·
                Jake Dunagan · Jacques Barcia · Victor Cui · Horatio M. Morgan ·
                Dr David J. Finch · David Rose · Dr Simon Raby · Roopa Reddy ·
                Adrian Conrad · Sudarshana Bhattacharya · Cedric Tai · Koreen
                Brennan · Jesse Tack · Krysta Traianovski · Charles Chan · Harry
                Gandhi · Sefunmi Osinaike
              </p>
            </div>
          </div>

          <footer class="guests-note">
            受邀不代表已确认出席、参与、发言角色，亦不代表对 Canada2080 的支持。
          </footer>
        </article>
      </div>

      <div class="card-slot">
        <article class="card card-itinerary" aria-labelledby="itinerary-title">
          <header class="card-topline card-topline-dark">
            <img
              class="topline-wordmark topline-wordmark-inverse"
              src="/brand/2080-wordmark.svg"
              alt="Canada2080"
              width="894"
              height="221"
            />
            <p class="card-kicker">议程</p>
          </header>

          <div class="itinerary-main">
            <p class="itinerary-label">140分钟启动对话与行动交流</p>
            <h2 id="itinerary-title">共同选择加拿大<br />
              要建设的未来。</h2>
            <ol class="timeline">
              <li>
                <time>T−30</time>
                <span>签到交流</span>
              </li>
              <li>
                <time>T+00</time>
                <span>开场：2020–2080发展轨迹与精准韧性</span>
              </li>
              <li>
                <time>T+20</time>
                <span>学术、产业与公共治理的视角</span>
              </li>
              <li>
                <time>T+35</time>
                <span>嘉宾圆桌或主持对话（待确认）</span>
              </li>
              <li>
                <time>T+55</time>
                <span>面向资本、机构与政策领导者的行动邀请</span>
              </li>
              <li>
                <time>T+65</time>
                <span>结束邀请：共同选择加拿大要建设的未来</span>
              </li>
              <li>
                <time>T+80</time>
                <span>围绕下一步行动的交流</span>
              </li>
            </ol>
          </div>

          <footer class="itinerary-footer">
            <p class="itinerary-note">
              圆桌、短讲与录制内容将以最终确认版本为准。
            </p>
            <div class="itinerary-meta">
              <p>具体时间将于周日晚上或周一公布</p>
              <p>canada2080.org</p>
            </div>
          </footer>
        </article>
      </div>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: 1080px 1080px;
    margin: 0;
  }

  :root {
    --signal: #f02e23;
    --ink: #071f26;
    --snow: #f5f4ef;
    --lake: #8fa6ad;
    --display:
      "PingFang SC", "Noto Sans SC", "Microsoft YaHei", "Arial Black",
      "Helvetica Neue", Arial, sans-serif;
    --body:
      "PingFang SC", "Noto Sans SC", "Microsoft YaHei", Arial, "Helvetica Neue",
      sans-serif;
    --mono:
      "SF Mono", ui-monospace, "PingFang SC", "Noto Sans SC", "Microsoft YaHei",
      SFMono-Regular, Consolas, monospace;
    --card-size: 1080px;
    --preview-size: min(720px, calc(100vw - 2rem));
    --preview-scale: calc(var(--preview-size) / var(--card-size));
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  body {
    background: #d8e0e1;
    color: var(--ink);
    font-family: var(--body);
  }

  .deck {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    justify-content: center;
    padding: clamp(1rem, 3vw, 2.5rem) 1rem;
  }

  .card-slot {
    width: var(--preview-size);
    height: var(--preview-size);
    overflow: hidden;
    box-shadow: 0 1rem 2.5rem rgb(7 31 38 / 16%);
  }

  .card {
    width: var(--card-size);
    height: var(--card-size);
    padding: 68px 72px 64px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(var(--preview-scale));
    transform-origin: top left;
  }

  .card-cover {
    position: relative;
    color: var(--snow);
    background: var(--ink);
  }

  .card-itinerary {
    color: var(--snow);
    background: var(--ink);
  }

  .card-guests {
    color: var(--ink);
    background: var(--snow);
  }

  .meta,
  .card-kicker,
  .itinerary-label,
  .cover-mark,
  .guest-further-label {
    margin: 0;
    color: var(--signal);
    font: 700 18px/1.25 var(--body);
    letter-spacing: 0.08em;
  }

  /* —— Cover —— */
  .cover-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cover-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .cover-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(7 31 38 / 48%) 0%,
        rgb(7 31 38 / 34%) 38%,
        rgb(7 31 38 / 78%) 72%,
        rgb(7 31 38 / 92%) 100%
      ),
      radial-gradient(
        ellipse at 30% 20%,
        rgb(7 31 38 / 8%) 0%,
        rgb(7 31 38 / 42%) 100%
      );
  }

  .cover-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .cover-brand {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-shrink: 0;
  }

  .cover-wordmark {
    display: block;
    width: 560px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgb(0 0 0 / 35%));
  }

  .cover-mark {
    padding-top: 0.45rem;
    text-align: right;
  }

  .cover-body {
    margin-top: 72px;
    width: 100%;
    max-width: none;
  }

  .signal-rule {
    width: 64px;
    height: 4px;
    margin-bottom: 28px;
    background: var(--signal);
  }

  .cover-body h1 {
    width: 100%;
    margin: 0 0 24px;
    max-width: none;
    font: 900 36px/1.24 var(--display);
    letter-spacing: 0.01em;
    text-shadow: 0 8px 28px rgb(0 0 0 / 40%);
  }

  .cover-body h1 span {
    display: block;
    width: max-content;
    white-space: nowrap;
  }

  .cover-deck {
    margin: 0;
    max-width: 18em;
    font: 700 24px/1.45 var(--body);
    color: #e8eeef;
    text-shadow: 0 2px 16px rgb(0 0 0 / 45%);
  }

  .cover-details {
    margin-top: auto;
    padding-top: 36px;
    border-top: 1px solid rgb(143 166 173 / 45%);
  }

  .cover-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .cover-detail {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .cover-detail .meta {
    font-size: 15px;
    color: #b7c6ca;
  }

  .cover-detail strong {
    font: 700 17px/1.28 var(--body);
  }

  .cover-detail-address {
    display: block;
    margin-top: 2px;
    color: var(--snow);
    font: 700 12px/1.2 var(--body);
    letter-spacing: 0.01em;
  }

  .cover-detail-venue strong {
    font-size: 15px;
    line-height: 1.18;
  }

  .cover-detail-venue .cover-detail-sub {
    margin-top: 0;
    font-size: 14px;
    line-height: 1.18;
  }

  .cover-detail-sub {
    font-weight: 600 !important;
    color: #c5d0d3;
  }

  .cover-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-top: 18px;
  }

  .cover-site {
    margin: 0;
    font: 700 15px/1 var(--mono);
    letter-spacing: 0.06em;
    color: var(--lake);
  }

  .cover-credit {
    margin: 0;
    max-width: 22rem;
    text-align: right;
  }

  .cover-credit p {
    margin: 0;
    max-width: none;
  }

  .cover-credit-subject {
    font: 700 14px/1.35 var(--body);
    letter-spacing: 0.04em;
    color: var(--snow);
  }

  .cover-credit-place,
  .cover-credit-photo {
    margin-top: 0.15rem;
    font: 500 13px/1.4 var(--body);
    letter-spacing: 0.02em;
    color: rgb(245 244 239 / 72%);
  }

  .cover-credit-photo {
    color: rgb(245 244 239 / 58%);
  }

  /* —— Shared topline —— */
  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .topline-wordmark {
    display: block;
    width: 188px;
    height: auto;
  }

  /* —— Guests —— */
  .guests-cluster {
    margin-top: auto;
    margin-bottom: auto;
    padding-block: 12px;
  }

  .guests-main {
    margin-top: 0;
  }

  .card-guests {
    padding-right: 48px;
    padding-left: 48px;
  }

  .guests-main h2 {
    margin: 0 0 36px;
    width: 100%;
    max-width: none;
    font: 900 48px/1.18 var(--display);
    letter-spacing: 0.01em;
  }

  .guests-main h2 span {
    display: block;
    width: max-content;
    white-space: nowrap;
  }

  .guests-main h2 .guests-title-final {
    font-size: 1em;
    letter-spacing: 0;
  }

  .guest-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 40px;
    align-items: start;
  }

  .guest-columns section {
    border-top: 4px solid var(--signal);
    padding-top: 16px;
  }

  .guest-columns h3 {
    margin: 0 0 16px;
    font: 900 24px/1.25 var(--display);
    letter-spacing: 0.01em;
  }

  .guest-columns ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guest-columns li {
    margin: 0 0 8px;
    font: 700 21px/1.35 var(--body);
  }

  .guest-further {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgb(7 31 38 / 18%);
  }

  .guest-further-label {
    margin-bottom: 12px;
    color: #8fa6ad;
  }

  .guest-further-names {
    margin: 0;
    color: #8fa6ad;
    font: 600 16px/1.55 var(--body);
    max-width: none;
  }

  .guests-note {
    margin-top: 0;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
    font: 700 15px/1.4 var(--body);
    max-width: none;
  }

  /* —— Itinerary —— */
  .itinerary-main {
    margin-top: auto;
    margin-bottom: auto;
    padding-block: 8px;
    flex: 0 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .itinerary-label {
    margin-bottom: 14px;
  }

  .itinerary-main h2 {
    margin: 0 0 32px;
    max-width: 10em;
    font: 900 44px/1.18 var(--display);
    letter-spacing: 0.01em;
  }

  .timeline {
    --time-col: 112px;
    --rail-inset: 128px;
    position: relative;
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline::before {
    position: absolute;
    top: 0.45em;
    bottom: 0.45em;
    left: var(--rail-inset);
    width: 2px;
    background: var(--signal);
    content: "";
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: var(--time-col) minmax(0, 1fr);
    column-gap: 36px;
    align-items: baseline;
  }

  .timeline li::before {
    position: absolute;
    top: 0.45em;
    left: calc(var(--rail-inset) - 5px);
    width: 12px;
    height: 12px;
    border: 2px solid var(--signal);
    border-radius: 50%;
    background: var(--ink);
    content: "";
  }

  .timeline time {
    color: var(--lake);
    font: 700 24px/1.2 var(--mono);
    letter-spacing: 0.02em;
    text-align: left;
  }

  .timeline span {
    font: 700 22px/1.4 var(--body);
    max-width: 18em;
  }

  .itinerary-footer {
    margin-top: 0;
    padding-top: 22px;
    border-top: 1px solid rgb(143 166 173 / 55%);
    display: grid;
    gap: 12px;
  }

  .itinerary-note {
    margin: 0;
    color: #a8b7bb;
    font: 600 14px/1.45 var(--body);
    max-width: none;
  }

  .itinerary-meta {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    font: 700 15px/1.35 var(--body);
    letter-spacing: 0.02em;
    color: var(--lake);
  }

  .itinerary-meta p {
    margin: 0;
  }

  @media (max-width: 40rem) {
    :root {
      --preview-size: calc(100vw - 1.25rem);
    }

    .deck {
      padding: 0.75rem 0.625rem;
      gap: 1rem;
    }
  }

  @media print {
    body {
      background: transparent;
    }

    .deck {
      display: block;
      padding: 0;
      gap: 0;
    }

    .card-slot {
      width: 1080px;
      height: 1080px;
      overflow: visible;
      box-shadow: none;
    }

    .card {
      transform: none;
      box-shadow: none;
      break-after: page;
      page-break-after: always;
    }

    .card:last-child {
      break-after: auto;
      page-break-after: auto;
    }
  }
</style>

<style is:global>
  /* Card 2 uses the full 1080px card interior: the two authored lines must not auto-wrap. */
  .card-guests .guests-main {
    width: 984px;
  }

  .card-guests .guests-main h2 {
    width: 984px;
    max-width: 984px;
  }

  .card-guests .guests-main h2 span,
  .card-guests .guests-main h2 .guests-title-final {
    display: block;
    width: max-content;
    max-width: none;
    font-size: 1em;
    white-space: nowrap;
  }
</style>
