---
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Canada2080 启动活动邀请卡片，2026年10月4日星期日。"
    />
    <meta name="robots" content="noindex" />
    <title>Canada2080 启动活动邀请卡片</title>
  </head>
  <body>
    <main class="deck" aria-label="Canada2080 启动活动邀请卡片">
      <header class="deck-toolbar">
        <div class="deck-toolbar-copy">
          <p class="deck-toolbar-title">Canada2080 启动活动卡片</p>
          <p class="deck-toolbar-note">1080 × 1080 PNG，便于分享与印刷。</p>
        </div>
        <button type="button" class="deck-download-all" data-download-all>
          下载全部五张
        </button>
      </header>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-cover"
            aria-labelledby="cover-title"
            data-card-file="canada2080-kickoff-zh-01-cover.png"
          >
          <div class="cover-media" aria-hidden="true">
            <img
              class="cover-photo"
              src="/images/hero/toronto-lake.jpg"
              alt=""
              width="2400"
              height="1600"
            />
            <div class="cover-veil"></div>
          </div>

          <div class="cover-content">
            <header class="cover-brand">
              <img
                class="cover-wordmark"
                src="/brand/2080-wordmark.svg"
                alt="Canada2080"
                width="894"
                height="221"
              />
              <p class="cover-mark">启动发布会</p>
            </header>

            <div class="cover-body">
              <div class="signal-rule" aria-hidden="true"></div>
              <h1 id="cover-title">
                <span>共同建设一个丰盛、</span>
                <span>坚韧、可持续、</span>
                <span>由加拿大自主掌握的未来。</span>
              </h1>
              <p class="cover-deck">
                到2080年，<br />
                加拿大将成为世界主要经济强国之一。<br />
                凭借在本土建设的主权产业、<br />
                科研、资本与公共价值，<br />
                加拿大将具备超越美国的能力。
              </p>
            </div>

            <footer class="cover-details">
              <div class="cover-grid">
                <div class="cover-detail">
                  <span class="meta">日期</span>
                  <strong>2026年10月4日，星期日</strong>
                </div>
                <div class="cover-detail cover-detail-venue">
                  <span class="meta">场地</span>
                  <strong>Hilton Toronto/Markham Suites<br />Conference Centre</strong>
                  <strong class="cover-detail-sub">Markham Ballroom</strong>
                  <span class="cover-detail-address">8500 Warden Ave.,<br />Markham, ON L6G 1A5</span>
                </div>
                <div class="cover-detail">
                  <span class="meta">参与方式</span>
                  <strong>现场与线上均可。</strong>
                  <strong class="cover-detail-sub">12:30 p.m. 开始签到入场</strong>
                  <strong class="cover-detail-sub">1:00 p.m. 准时开始</strong>
                  <strong class="cover-detail-sub">线上：Google Meet</strong>
                </div>
              </div>
              <div class="cover-bottom">
                <p class="cover-site">canada2080.org</p>
              </div>
            </footer>
          </div>
        </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">01 · 封面</span>
          <button type="button" class="card-download" data-download-card>下载 PNG</button>
        </figcaption>
      </figure>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-tripartite"
            aria-labelledby="tripartite-title"
            data-card-file="canada2080-kickoff-zh-02-tripartite.png"
          >
          <header class="card-topline">
            <img class="topline-wordmark topline-wordmark-ink" src="/brand/2080-wordmark-ink.svg" alt="Canada2080" width="894" height="221" />
            <p class="card-kicker">三方生态系统模型</p>
          </header>
          <div class="tripartite-card-main">
            <h2 id="tripartite-title">创新发生在<br />治理、教育与产业相遇之处。</h2>
            <div class="tripartite-card-map" role="img" aria-label="治理、教育与产业通过共同场域连接，形成能力与公共价值">
              <svg class="tripartite-card-lines" viewBox="0 0 860 520" aria-hidden="true" focusable="false">
                <path d="M430 85 L430 260 M120 440 L430 260 M740 440 L430 260" />
              </svg>
              <div class="tripartite-card-node tripartite-card-governance"><span>01</span><strong>治理</strong><small>公共目标<br />政策<br />信任</small></div>
              <div class="tripartite-card-node tripartite-card-education"><span>02</span><strong>教育</strong><small>科研<br />人才<br />学习</small></div>
              <div class="tripartite-card-node tripartite-card-industry"><span>03</span><strong>产业</strong><small>需求<br />生产<br />资本</small></div>
              <div class="tripartite-card-centre"><span>共同场域</span><strong>能力持续形成</strong><small>共同建设公共价值</small></div>
            </div>
          </div>
          <footer class="tripartite-card-footer">三方各自提供不同能力。只有责任、资源与行动真正连接，创新才能持续转化为公共价值。</footer>
        </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">02 · 三方模型</span>
          <button type="button" class="card-download" data-download-card>下载 PNG</button>
        </figcaption>
      </figure>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-guests"
            aria-labelledby="guests-title"
            data-card-file="canada2080-kickoff-zh-03-guests.png"
          >
          <header class="card-topline">
            <img
              class="topline-wordmark topline-wordmark-ink"
              src="/brand/2080-wordmark-ink.svg"
              alt="Canada2080"
              width="894"
              height="221"
            />
            <p class="card-kicker">受邀嘉宾</p>
          </header>

          <div class="guests-cluster">
            <div class="guests-main">
              <h2 id="guests-title">
                <span class="guests-title-line">治理、教育与产业，</span>
                <span class="guests-title-line guests-title-final">共同建设加拿大未来。</span>
              </h2>
              <div class="guest-columns">
                <section aria-labelledby="guests-public">
                  <h3 id="guests-public">治理<br />市政领导者</h3>
                  <ul>
                    <li>Frank Scarpitti</li>
                    <li>Alan Ho</li>
                    <li>Shaun Chen</li>
                  </ul>
                </section>
                <section aria-labelledby="guests-research">
                  <h3 id="guests-research">教育<br />科研领导者</h3>
                  <ul>
                    <li>Dr Barry Wylant</li>
                    <li>Greg Hart</li>
                    <li>Prof Jay Gonzalez</li>
                    <li>Dr Erin Trochim</li>
                    <li>Dr Kimberly Yazzie</li>
                  </ul>
                </section>
                <section aria-labelledby="guests-capability">
                  <h3 id="guests-capability">产业<br />创新领导者</h3>
                  <ul>
                    <li>Pyn Lim</li>
                    <li>Himanshu Joshi</li>
                    <li>Yulia Korobkova</li>
                    <li>Diarmuid Nash</li>
                    <li>Dr Sudarshana Bhattacharya</li>
                  </ul>
                </section>
              </div>
            </div>

            <div class="guest-further">
              <p class="guest-further-label">其他受邀生态系统参与者</p>
              <p class="guest-further-names">
                Horatio M. Morgan · Adrian Conrad · Dr Michael Donaldson ·
                Cedric Tai · Krysta Traianovski · Charles Chan · Harry Gandhi ·
                Sefunmi Osinaike
              </p>
            </div>
          </div>

          <footer class="guests-note">
            受邀不代表已确认出席、参与、发言角色，亦不代表对 Canada2080 的支持。
          </footer>
        </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">03 · 受邀嘉宾</span>
          <button type="button" class="card-download" data-download-card>下载 PNG</button>
        </figcaption>
      </figure>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-itinerary"
            aria-labelledby="itinerary-title"
            data-card-file="canada2080-kickoff-zh-04-itinerary.png"
          >
          <header class="card-topline card-topline-dark">
            <img
              class="topline-wordmark topline-wordmark-inverse"
              src="/brand/2080-wordmark.svg"
              alt="Canada2080"
              width="894"
              height="221"
            />
            <p class="card-kicker">议程</p>
          </header>

          <div class="itinerary-main">
            <p class="itinerary-label">150分钟公开启动活动</p>
            <h2 id="itinerary-title">共同选择加拿大<br />
              要建设的未来。</h2>
            <ol class="timeline">
              <li>
                <time>12:30</time>
                <span>签到交流</span>
              </li>
              <li>
                <time>13:00</time>
                <span>主持开场与议程介绍</span>
              </li>
              <li>
                <time>13:05</time>
                <span>市政欢迎致辞</span>
              </li>
              <li>
                <time>13:10</time>
                <span>Canada2080：长期挑战</span>
              </li>
              <li>
                <time>13:20</time>
                <span>受邀嘉宾演讲：主权 AI 与可信部署</span>
              </li>
              <li>
                <time>13:40</time>
                <span>专题一：主权 AI、数据治理与可信部署</span>
              </li>
              <li>
                <time>13:55</time>
                <span>受邀嘉宾演讲：基础设施与本土规模化</span>
              </li>
              <li>
                <time>14:10</time>
                <span>专题二：国家能力建设</span>
              </li>
              <li>
                <time>14:25</time>
                <span>总结与行动邀请</span>
              </li>
              <li>
                <time>14:30</time>
                <span>交流与后续对接</span>
              </li>
            </ol>
          </div>

          <footer class="itinerary-footer">
            <p class="itinerary-note">
              贡献者与讨论主题将在确认后公布。
            </p>
            <div class="itinerary-meta">
              <p>12:30 入场签到 · 13:00 准时开始</p>
              <p>canada2080.org</p>
            </div>
          </footer>
        </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">04 · 议程</span>
          <button type="button" class="card-download" data-download-card>下载 PNG</button>
        </figcaption>
      </figure>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-rsvp"
            aria-labelledby="rsvp-title"
            data-card-file="canada2080-kickoff-zh-05-rsvp.png"
          >
            <header class="card-topline">
              <img
                class="topline-wordmark topline-wordmark-inverse"
                src="/brand/2080-wordmark.svg"
                alt="Canada2080"
                width="894"
                height="221"
              />
              <p class="card-kicker">报名</p>
            </header>
            <div class="rsvp-main">
              <div class="rsvp-copy">
                <p class="rsvp-eyebrow">2026年10月4日，星期日</p>
                <h2 id="rsvp-title">参与一场为<br />加拿大未来<br />奠基的对话。</h2>
                <p>
                  Markham Ballroom · Hilton Toronto/Markham<br />
                  12:30 入场签到<br />
                  13:00 准时开始<br />
                  线上：Google Meet
                </p>
                <p class="rsvp-instruction">扫码前往 Luma 报名。</p>
                <p class="rsvp-url">luma.com/w7g9hjb7</p>
              </div>
              <img
                class="rsvp-qr"
                src="/images/canada2080-kickoff-rsvp-qr.png"
                alt="前往 Canada2080 启动活动 Luma 报名页面的二维码"
                width="440"
                height="440"
              />
            </div>
            <footer class="rsvp-footer">
              提供现场与线上参与方式。
            </footer>
          </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">05 · 报名</span>
          <button type="button" class="card-download" data-download-card>下载 PNG</button>
        </figcaption>
      </figure>
    </main>

    <script>
      import { bindCardExportControls } from "../../lib/export-card-image";

      bindCardExportControls({
        preparing: "准备中…",
        retry: "再试一次",
        idleOne: "下载 PNG",
        idleAll: "下载全部五张",
        saving: (index, total) => `正在保存 ${index} / ${total}…`,
      });
    </script>
  </body>
</html>

<style is:global>
  @page {
    size: 1080px 1080px;
    margin: 0;
  }

  :root {
    --signal: #f02e23;
    --ink: #071f26;
    --snow: #f5f4ef;
    --lake: #8fa6ad;
    --display:
      "PingFang SC", "Noto Sans SC", "Microsoft YaHei", "Arial Black",
      "Helvetica Neue", Arial, sans-serif;
    --body:
      "PingFang SC", "Noto Sans SC", "Microsoft YaHei", Arial, "Helvetica Neue",
      sans-serif;
    --mono:
      "SF Mono", ui-monospace, "PingFang SC", "Noto Sans SC", "Microsoft YaHei",
      SFMono-Regular, Consolas, monospace;
    --card-size: 1080px;
    --preview-size: min(720px, calc(100vw - 2rem));
    --preview-scale: calc(var(--preview-size) / var(--card-size));
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  body {
    background: #d8e0e1;
    color: var(--ink);
    font-family: var(--body);
  }

  .deck {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    justify-content: center;
    padding: clamp(1rem, 3vw, 2.5rem) 1rem;
  }

  .deck-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    width: var(--preview-size);
  }

  .deck-toolbar-title {
    margin: 0 0 0.25rem;
    font: 900 1.15rem/1.2 var(--display);
    letter-spacing: -0.03em;
  }

  .deck-toolbar-note {
    margin: 0;
    color: #496069;
    font: 600 0.92rem/1.35 var(--body);
  }

  .deck-download-all,
  .card-download {
    appearance: none;
    border: 1px solid var(--ink);
    background: var(--snow);
    color: var(--ink);
    cursor: pointer;
    font: 700 0.82rem/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.85rem 1rem;
  }

  .deck-download-all:hover,
  .card-download:hover {
    background: var(--ink);
    color: var(--snow);
  }

  .deck-download-all:disabled,
  .card-download:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .card-figure {
    display: grid;
    gap: 0.75rem;
    width: var(--preview-size);
    margin: 0;
  }

  .card-slot {
    width: 100%;
    height: var(--preview-size);
    overflow: hidden;
    box-shadow: 0 1rem 2.5rem rgb(7 31 38 / 16%);
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-label {
    color: #496069;
    font: 700 0.78rem/1.2 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card {
    width: var(--card-size);
    height: var(--card-size);
    padding: 68px 72px 64px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(var(--preview-scale));
    transform-origin: top left;
  }

  .card-cover {
    position: relative;
    color: var(--snow);
    background: var(--ink);
  }

  .card-itinerary {
    color: var(--snow);
    background: var(--ink);
  }

  .card-guests {
    color: var(--ink);
    background: var(--snow);
  }

  .card-rsvp {
    color: var(--snow);
    background: var(--ink);
  }

  .meta,
  .card-kicker,
  .itinerary-label,
  .cover-mark,
  .guest-further-label {
    margin: 0;
    color: var(--signal);
    font: 700 18px/1.25 var(--body);
    letter-spacing: 0.08em;
  }

  /* —— Cover —— */
  .cover-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cover-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .cover-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(7 31 38 / 48%) 0%,
        rgb(7 31 38 / 34%) 38%,
        rgb(7 31 38 / 78%) 72%,
        rgb(7 31 38 / 92%) 100%
      ),
      radial-gradient(
        ellipse at 30% 20%,
        rgb(7 31 38 / 8%) 0%,
        rgb(7 31 38 / 42%) 100%
      );
  }

  .cover-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .cover-brand {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-shrink: 0;
  }

  .cover-wordmark {
    display: block;
    width: 560px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgb(0 0 0 / 35%));
  }

  .cover-mark {
    padding-top: 0.45rem;
    text-align: right;
  }

  .cover-body {
    margin-top: 72px;
    width: 100%;
    max-width: none;
  }

  .signal-rule {
    width: 64px;
    height: 4px;
    margin-bottom: 28px;
    background: var(--signal);
  }

  .cover-body h1 {
    width: 100%;
    margin: 0 0 24px;
    max-width: none;
    font: 900 36px/1.24 var(--display);
    letter-spacing: 0.01em;
    text-shadow: 0 8px 28px rgb(0 0 0 / 40%);
  }

  .cover-body h1 span {
    display: block;
    width: max-content;
    white-space: nowrap;
  }

  .cover-deck {
    margin: 0;
    max-width: 18em;
    font: 700 24px/1.45 var(--body);
    color: #e8eeef;
    text-shadow: 0 2px 16px rgb(0 0 0 / 45%);
  }

  .cover-details {
    margin-top: auto;
    padding-top: 36px;
    border-top: 1px solid rgb(143 166 173 / 45%);
  }

  .cover-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .cover-detail {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .cover-detail .meta {
    font-size: 15px;
    color: #b7c6ca;
  }

  .cover-detail strong {
    font: 700 17px/1.28 var(--body);
  }

  .cover-detail-address {
    display: block;
    margin-top: 2px;
    color: var(--snow);
    font: 700 12px/1.2 var(--body);
    letter-spacing: 0.01em;
  }

  .cover-detail-venue strong {
    font-size: 15px;
    line-height: 1.18;
  }

  .cover-detail-venue .cover-detail-sub {
    margin-top: 0;
    font-size: 14px;
    line-height: 1.18;
  }

  .cover-detail-sub {
    font-weight: 600 !important;
    color: #c5d0d3;
  }

  .cover-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-top: 18px;
  }

  .cover-site {
    margin: 0;
    font: 700 15px/1 var(--mono);
    letter-spacing: 0.06em;
    color: var(--lake);
  }

  .cover-credit {
    margin: 0;
    max-width: 22rem;
    text-align: right;
  }

  .cover-credit p {
    margin: 0;
    max-width: none;
  }

  .cover-credit-subject {
    font: 700 14px/1.35 var(--body);
    letter-spacing: 0.04em;
    color: var(--snow);
  }

  .cover-credit-place,
  .cover-credit-photo {
    margin-top: 0.15rem;
    font: 500 13px/1.4 var(--body);
    letter-spacing: 0.02em;
    color: rgb(245 244 239 / 72%);
  }

  .cover-credit-photo {
    color: rgb(245 244 239 / 58%);
  }

  /* —— Shared topline —— */
  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .topline-wordmark {
    display: block;
    width: 188px;
    height: auto;
  }

  /* —— Guests —— */
  .guests-cluster {
    margin-top: auto;
    margin-bottom: auto;
    padding-block: 12px;
  }

  .guests-main {
    margin-top: 0;
  }

  .card-guests {
    padding-right: 48px;
    padding-left: 48px;
  }

  .guests-main h2 {
    margin: 0 0 36px;
    width: 984px;
    max-width: 984px;
    font: 900 48px/1.18 var(--display);
    letter-spacing: 0.01em;
  }

  .guests-main h2 span {
    display: block;
    width: max-content;
    max-width: none;
    white-space: nowrap;
  }

  .guests-main h2 .guests-title-final {
    font-size: 1em;
    letter-spacing: 0;
  }

  .guest-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 40px;
    align-items: start;
  }

  .guest-columns section {
    border-top: 4px solid var(--signal);
    padding-top: 16px;
  }

  .guest-columns h3 {
