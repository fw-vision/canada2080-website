<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Canada2080 kickoff invitation cards for Sunday, October 4, 2026."
    />
    <meta name="robots" content="noindex" />
    <title>Canada2080 kickoff invitation cards</title>
  </head>
  <body>
    <main class="deck" aria-label="Canada2080 kickoff invitation cards">
      <header class="deck-toolbar">
        <div class="deck-toolbar-copy">
          <p class="deck-toolbar-title">Canada2080 kickoff cards</p>
          <p class="deck-toolbar-note">1080 × 1080 PNGs for sharing and print.</p>
        </div>
        <button type="button" class="deck-download-all" data-download-all>
          Download all five
        </button>
      </header>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-cover"
            aria-labelledby="cover-title"
            data-card-file="canada2080-kickoff-01-cover.png"
          >
          <div class="cover-media" aria-hidden="true">
            <img
              class="cover-photo"
              src="/images/hero/toronto-lake.jpg"
              alt=""
              width="2400"
              height="1600"
            />
            <div class="cover-veil"></div>
          </div>

          <div class="cover-content">
            <header class="cover-brand">
              <img
                class="cover-wordmark"
                src="/brand/2080-wordmark.svg"
                alt="Canada2080"
                width="894"
                height="221"
              />
              <p class="cover-mark">Kickoff</p>
            </header>

            <div class="cover-body">
              <div class="signal-rule" aria-hidden="true"></div>
              <h1 id="cover-title">
                Actualizing an abundant, resilient, sustainable, and sovereign
                future for Canada.
              </h1>
              <p class="cover-deck">
                A national initiative for Canadian-controlled capability through
                2080.
              </p>
            </div>

            <footer class="cover-details">
              <div class="cover-grid">
                <div class="cover-detail">
                  <span class="meta">Date</span>
                  <strong>Sunday, 4 October 2026</strong>
                </div>
                <div class="cover-detail cover-detail-venue">
                  <span class="meta">Venue</span>
                  <strong>
                    Hilton Toronto/Markham Suites Conference Centre &amp; Spa
                  </strong>
                  <strong class="cover-detail-sub"
                    >Markham Ballroom</strong
                  >
                  <span class="cover-detail-address">8500 Warden Ave.<br />Markham, ON L6G 1A5</span>
                </div>
                <div class="cover-detail">
                  <span class="meta">Attendance</span>
                  <strong>In person and online.</strong>
                  <strong class="cover-detail-sub"
                    >Guest arrival: 12:30 p.m.</strong
                  >
                  <strong class="cover-detail-sub"
                    >Programme begins: 1:00 p.m.</strong
                  >
                  <strong class="cover-detail-sub"
                    >Online: Google Meet</strong
                  >
                </div>
              </div>
              <div class="cover-bottom">
                <p class="cover-site">canada2080.org</p>
                <aside class="cover-credit">
                  <p class="cover-credit-subject">
                    CN Tower across frozen Lake Ontario
                  </p>
                  <p class="cover-credit-place">Toronto, Ontario</p>
                  <p class="cover-credit-photo">
                    Photo: Filipe Freitas / Unsplash
                  </p>
                </aside>
              </div>
            </footer>
          </div>
        </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">01 · Cover</span>
          <button type="button" class="card-download" data-download-card>Download PNG</button>
        </figcaption>
      </figure>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-tripartite"
            aria-labelledby="tripartite-title"
            data-card-file="canada2080-kickoff-02-tripartite.png"
          >
          <header class="card-topline">
            <img class="topline-wordmark topline-wordmark-ink" src="/brand/2080-wordmark-ink.svg" alt="Canada2080" width="894" height="221" />
            <p class="card-kicker">Tripartite Ecosystem Model</p>
          </header>
          <div class="tripartite-card-main">
            <h2 id="tripartite-title">Innovation moves where Governance, Education, and Industry meet.</h2>
            <div class="tripartite-card-map" role="img" aria-label="Governance, Education, and Industry connected through a shared field of capability and public value">
              <svg class="tripartite-card-lines" viewBox="0 0 860 520" aria-hidden="true" focusable="false">
                <path d="M430 85 L430 260 M120 440 L430 260 M740 440 L430 260" />
              </svg>
              <div class="tripartite-card-node tripartite-card-governance"><span>01</span><strong>Governance</strong><small>Public purpose<br />Policy<br />Trust</small></div>
              <div class="tripartite-card-node tripartite-card-education"><span>02</span><strong>Education</strong><small>Research<br />Talent<br />Learning</small></div>
              <div class="tripartite-card-node tripartite-card-industry"><span>03</span><strong>Industry</strong><small>Demand<br />Production<br />Capital</small></div>
              <div class="tripartite-card-centre"><span>Shared field</span><strong>Capability in motion</strong><small>Public value built together</small></div>
            </div>
          </div>
          <footer class="tripartite-card-footer">Each sphere contributes a distinct capacity. Durable innovation emerges where their responsibilities connect.</footer>
        </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">02 · Tripartite model</span>
          <button type="button" class="card-download" data-download-card>Download PNG</button>
        </figcaption>
      </figure>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-guests"
            aria-labelledby="guests-title"
            data-card-file="canada2080-kickoff-03-guests.png"
          >
          <header class="card-topline">
            <img
              class="topline-wordmark topline-wordmark-ink"
              src="/brand/2080-wordmark-ink.svg"
              alt="Canada2080"
              width="894"
              height="221"
            />
            <p class="card-kicker">Invited guests</p>
          </header>

          <div class="guests-cluster">
            <div class="guests-main">
              <h2 id="guests-title">Governance. Education. Industry.</h2>
              <div class="guest-columns">
                <section aria-labelledby="guests-public">
                  <h3 id="guests-public">Governance:<br />Municipal leaders</h3>
                  <ul>
                    <li>Frank Scarpitti</li>
                    <li>Alan Ho</li>
                    <li>Shaun Chen</li>
                  </ul>
                </section>
                <section aria-labelledby="guests-research">
                  <h3 id="guests-research">Education:<br />Research leaders</h3>
                  <ul>
                    <li>Barry Wylant</li>
                    <li>Larry Smith</li>
                    <li>Prof Jay Gonzalez</li>
                    <li>Erin Trochim</li>
                    <li>Kimberly Yazzie</li>
                  </ul>
                </section>
                <section aria-labelledby="guests-capability">
                  <h3 id="guests-capability">Industry:<br />Innovation leaders</h3>
                  <ul>
                    <li>Pyn Lim</li>
                    <li>Himanshu Joshi</li>
                    <li>Yulia Korobkova</li>
                    <li>Diarmuid Nash</li>
                    <li>Michael Donaldson</li>
                  </ul>
                </section>
              </div>
            </div>

            <div class="guest-further">
              <p class="guest-further-label">Also invited</p>
              <p class="guest-further-names">
                Greg Hart · Jeff Clune · Dr Marc Hurwitz · Matti Siemiatycki ·
                Jake Dunagan · Jacques Barcia · Victor Cui · Horatio M. Morgan ·
                Dr David J. Finch · David Rose · Dr Simon Raby · Roopa Reddy ·
                Adrian Conrad · Sudarshana Bhattacharya · Cedric Tai · Koreen
                Brennan · Jesse Tack · Krysta Traianovski · Charles Chan · Harry
                Gandhi · Sefunmi Osinaike
              </p>
            </div>
          </div>

          <footer class="guests-note">
            Invitation does not confirm attendance, participation, speaking
            role, or endorsement.
          </footer>
        </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">03 · Invited guests</span>
          <button type="button" class="card-download" data-download-card>Download PNG</button>
        </figcaption>
      </figure>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-itinerary"
            aria-labelledby="itinerary-title"
            data-card-file="canada2080-kickoff-04-itinerary.png"
          >
          <header class="card-topline card-topline-dark">
            <img
              class="topline-wordmark topline-wordmark-inverse"
              src="/brand/2080-wordmark.svg"
              alt="Canada2080"
              width="894"
              height="221"
            />
            <p class="card-kicker">Itinerary</p>
          </header>

          <div class="itinerary-main">
            <p class="itinerary-label">150-minute founding conversation</p>
            <h2 id="itinerary-title">Choose what Canada will build.</h2>
            <ol class="timeline">
              <li>
                <time>12:30 p.m.</time>
                <span>Arrival and networking</span>
              </li>
              <li>
                <time>1:00 p.m.</time>
                <span
                  >Opening address: the 2020–2080 trajectory and precision
                  resilience</span
                >
              </li>
              <li>
                <time>1:20 p.m.</time>
                <span
                  >Invited academic, industry, and governance
                  perspectives</span
                >
              </li>
              <li>
                <time>1:45 p.m.</time>
                <span>Speaker panel or moderated conversation</span>
              </li>
              <li>
                <time>2:05 p.m.</time>
                <span
                  >Roles and calls to capital, institutions, and policy
                  leaders</span
                >
              </li>
              <li>
                <time>2:15 p.m.</time>
                <span>Closing invitation: choose what Canada will build</span>
              </li>
              <li>
                <time>2:30 p.m.</time>
                <span>Commitment-focused networking</span>
              </li>
            </ol>
          </div>

          <footer class="itinerary-footer">
            <p class="itinerary-note">
              Speaking segments may expand as guests volunteer for keynotes or
              panels. A second panel would extend the programme.
            </p>
            <div class="itinerary-meta">
              <p>Guest arrival 12:30 p.m. · Programme begins 1:00 p.m.</p>
              <p>canada2080.org</p>
            </div>
          </footer>
        </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">04 · Itinerary</span>
          <button type="button" class="card-download" data-download-card>Download PNG</button>
        </figcaption>
      </figure>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-rsvp"
            style="background: #071f26; color: #f5f4ef"
            aria-labelledby="rsvp-title"
            data-card-file="canada2080-kickoff-05-rsvp.png"
          >
            <header class="card-topline">
              <img
                class="topline-wordmark topline-wordmark-inverse"
                src="/brand/2080-wordmark.svg"
                alt="Canada2080"
                width="894"
                height="221"
              />
              <p class="card-kicker">RSVP</p>
            </header>
            <div class="rsvp-main">
              <div class="rsvp-copy">
                <p class="rsvp-eyebrow">Sunday, 4 October 2026</p>
                <h2 id="rsvp-title">Join the founding conversation.</h2>
                <p>
                  Markham Ballroom · Hilton Toronto/Markham<br />
                  Guest arrival: 12:30 p.m.<br />
                  Programme begins: 1:00 p.m.<br />
                  Online: Google Meet
                </p>
                <p class="rsvp-instruction">Scan the code to RSVP on Luma.</p>
                <p class="rsvp-url">luma.com/w7g9hjb7</p>
              </div>
              <img
                class="rsvp-qr"
                src="/images/canada2080-kickoff-rsvp-qr.png"
                alt="QR code linking to the Canada2080 kickoff RSVP on Luma"
                width="440"
                height="440"
              />
            </div>
            <footer class="rsvp-footer">
              In person and online attendance available.
            </footer>
          </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">05 · RSVP</span>
          <button type="button" class="card-download" data-download-card>Download PNG</button>
        </figcaption>
      </figure>
    </main>

    <script>
      import { toBlob } from "html-to-image";

      const CARD_SIZE = 1080;

      function sleep(ms: number) {
        return new Promise((resolve) => setTimeout(resolve, ms));
      }

      async function waitForCardAssets(card: HTMLElement) {
        await document.fonts?.ready;

        await Promise.all(
          [...card.querySelectorAll<HTMLImageElement>("img")].map(async (image) => {
            if (!image.complete) {
              await new Promise<void>((resolve, reject) => {
                image.addEventListener("load", () => resolve(), { once: true });
                image.addEventListener("error", () => reject(new Error(`Could not load ${image.src}`)), { once: true });
              });
            }
            if (!image.naturalWidth) {
              throw new Error(`Could not load ${image.src}`);
            }
            await image.decode?.().catch(() => undefined);
          }),
        );

        await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
      }

      async function exportCard(card: HTMLElement, filename: string) {
        const slot = card.closest(".card-slot") as HTMLElement | null;
        if (!slot) throw new Error("Card is missing its export slot");

        const previous = {
          slotWidth: slot.style.width,
          slotHeight: slot.style.height,
          cardTransform: card.style.transform,
        };

        slot.style.width = `${CARD_SIZE}px`;
        slot.style.height = `${CARD_SIZE}px`;
        card.style.transform = "none";

        try {
          await waitForCardAssets(card);
          const backgroundColor = card.classList.contains("card-rsvp")
            ? "#071f26"
            : getComputedStyle(card).backgroundColor;
          const blob = await toBlob(card, {
            width: CARD_SIZE,
            height: CARD_SIZE,
            pixelRatio: 1,
            backgroundColor,
            skipFonts: true,
            cacheBust: false,
            style: {
              background: backgroundColor,
              backgroundColor,
              transform: "none",
              transformOrigin: "top left",
            },
          });
          if (!blob) throw new Error("Could not render PNG");

          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.download = filename;
          link.href = url;
          document.body.append(link);
          link.click();
          link.remove();
          window.setTimeout(() => URL.revokeObjectURL(url), 0);
        } finally {
          slot.style.width = previous.slotWidth;
          slot.style.height = previous.slotHeight;
          card.style.transform = previous.cardTransform;
        }
      }

      async function downloadOne(button: HTMLButtonElement) {
        const figure = button.closest(".card-figure");
        const card = figure?.querySelector<HTMLElement>(".card[data-card-file]");
        const filename = card?.dataset.cardFile;
        if (!card || !filename) return;

        const label = button.textContent;
        button.disabled = true;
        button.textContent = "Preparing…";
        try {
          await exportCard(card, filename);
        } catch (error) {
          console.error(error);
          button.textContent = "Try again";
          await sleep(1200);
        } finally {
          button.disabled = false;
          button.textContent = label || "Download PNG";
        }
      }

      async function downloadAll(button: HTMLButtonElement) {
        const cards = [
          ...document.querySelectorAll<HTMLElement>(".card[data-card-file]"),
        ];
        const label = button.textContent;
        button.disabled = true;

        try {
          for (let index = 0; index < cards.length; index += 1) {
            const card = cards[index];
            const filename = card.dataset.cardFile;
            if (!filename) continue;
            button.textContent = `Saving ${index + 1} of ${cards.length}…`;
            await exportCard(card, filename);
            await sleep(350);
          }
        } catch (error) {
          console.error(error);
          button.textContent = "Try again";
          await sleep(1200);
        } finally {
          button.disabled = false;
          button.textContent = label || "Download all five";
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-download-card]").forEach((button) => {
        button.addEventListener("click", () => {
          void downloadOne(button);
        });
      });

      document.querySelectorAll<HTMLButtonElement>("[data-download-all]").forEach((button) => {
        button.addEventListener("click", () => {
          void downloadAll(button);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @page {
    size: 1080px 1080px;
    margin: 0;
  }

  :root {
    --signal: #f02e23;
    --ink: #071f26;
    --snow: #f5f4ef;
    --lake: #8fa6ad;
    --display: "Arial Black", "Helvetica Neue", Arial, sans-serif;
    --body: Arial, "Helvetica Neue", sans-serif;
    --mono: ui-monospace, SFMono-Regular, Consolas, monospace;
    --card-size: 1080px;
    --preview-size: min(720px, calc(100vw - 2rem));
    --preview-scale: calc(var(--preview-size) / var(--card-size));
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  body {
    background: #d8e0e1;
    color: var(--ink);
    font-family: var(--body);
  }

  .deck {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    justify-content: center;
    padding: clamp(1rem, 3vw, 2.5rem) 1rem;
  }

  .deck-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    width: var(--preview-size);
  }

  .deck-toolbar-title {
    margin: 0 0 0.25rem;
    font: 900 1.15rem/1.2 var(--display);
    letter-spacing: -0.03em;
  }

  .deck-toolbar-note {
    margin: 0;
    color: #496069;
    font: 600 0.92rem/1.35 var(--body);
  }

  .deck-download-all,
  .card-download {
    appearance: none;
    border: 1px solid var(--ink);
    background: var(--snow);
    color: var(--ink);
    cursor: pointer;
    font: 700 0.82rem/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.85rem 1rem;
  }

  .deck-download-all:hover,
  .card-download:hover {
    background: var(--ink);
    color: var(--snow);
  }

  .deck-download-all:disabled,
  .card-download:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .card-figure {
    display: grid;
    gap: 0.75rem;
    width: var(--preview-size);
    margin: 0;
  }

  .card-slot {
    width: 100%;
    height: var(--preview-size);
    overflow: hidden;
    box-shadow: 0 1rem 2.5rem rgb(7 31 38 / 16%);
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-label {
    color: #496069;
    font: 700 0.78rem/1.2 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card {
    width: var(--card-size);
    height: var(--card-size);
    padding: 68px 72px 64px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(var(--preview-scale));
    transform-origin: top left;
  }

  .card-cover {
    position: relative;
    color: var(--snow);
    background: var(--ink);
  }

  .card-itinerary {
    color: var(--snow);
    background: var(--ink);
  }

  .card-guests {
    color: var(--ink);
    background: var(--snow);
  }

  .card-rsvp {
    color: var(--snow);
    background: var(--ink);
  }

  .meta,
  .card-kicker,
  .itinerary-label,
  .cover-mark,
  .guest-further-label {
    margin: 0;
    color: var(--signal);
    font: 700 16px/1.2 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* —— Cover —— */
  .cover-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cover-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .cover-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgb(7 31 38 / 48%) 0%,
        rgb(7 31 38 / 34%) 38%,
        rgb(7 31 38 / 78%) 72%,
        rgb(7 31 38 / 92%) 100%
      ),
      radial-gradient(
        ellipse at 30% 20%,
        rgb(7 31 38 / 8%) 0%,
        rgb(7 31 38 / 42%) 100%
      );
  }

  .cover-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .cover-brand {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-shrink: 0;
  }

  .cover-wordmark {
    display: block;
    width: 560px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgb(0 0 0 / 35%));
  }

  .cover-mark {
    padding-top: 0.4rem;
    text-align: right;
  }

  .cover-body {
    margin-top: 72px;
    max-width: 940px;
  }

  .signal-rule {
    width: 64px;
    height: 4px;
    margin-bottom: 28px;
    background: var(--signal);
  }

  .cover-body h1 {
    margin: 0 0 24px;
    max-width: 18ch;
    font: 900 64px/0.95 var(--display);
    letter-spacing: -0.065em;
    text-shadow: 0 8px 28px rgb(0 0 0 / 40%);
  }

  .cover-deck {
    margin: 0;
    max-width: 32ch;
    font: 700 24px/1.32 var(--body);
    color: #e8eeef;
    text-shadow: 0 2px 16px rgb(0 0 0 / 45%);
  }

  .cover-details {
    margin-top: auto;
    padding-top: 36px;
    border-top: 1px solid rgb(143 166 173 / 45%);
  }

  .cover-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .cover-detail {
    display: grid;
    min-width: 0;
    gap: 8px;
    align-content: start;
  }

  .cover-detail .meta {
    font-size: 13px;
    color: #b7c6ca;
  }

  .cover-detail strong {
    font: 700 19px/1.28 var(--body);
  }

  .cover-detail-venue strong {
    font-size: 17px;
    line-height: 1.2;
  }

  .cover-detail-venue .cover-detail-sub {
    font-size: 15px;
    line-height: 1.2;
  }

  .cover-detail-address {
    display: block;
    margin-top: 3px;
    color: #c5d0d3;
    font: 600 12px/1.2 var(--body);
    letter-spacing: 0.01em;
  }

  .cover-detail-sub {
    font-weight: 600 !important;
    color: #c5d0d3;
  }

  .cover-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 22px;
  }

  .cover-site {
    margin: 0;
    font: 700 15px/1 var(--mono);
    letter-spacing: 0.06em;
    color: var(--lake);
  }

  .cover-credit {
    margin: 0;
    max-width: 22rem;
    text-align: right;
  }

