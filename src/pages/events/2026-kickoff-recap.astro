---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StatementLink from "../../components/StatementLink.astro";
import TripartiteEcosystem from "../../components/TripartiteEcosystem.astro";

const galleryDir = path.join(
    process.cwd(),
    "public/images/events/2026-kickoff/gallery",
);
const gallery = [
    "img_5329.jpg",
    "img_5331.jpg",
    "img_5332.jpg",
    "img_5335.jpg",
    "img_5340.jpg",
    "img_5343.jpg",
    "img_5347.jpg",
    "img_5349.jpg",
    "img_5350.jpg",
    "img_5351.jpg",
    "img_5363.jpg",
    "img_5373.jpg",
    "img_5380.jpg",
    "img_5390.jpg",
    "img_5392.jpg",
    "img_5398.jpg",
    "img_5406.jpg",
    "img_5408.jpg",
    "img_5410.jpg",
    "img_5417.jpg",
    "img_5425.jpg",
    "img_5430.jpg",
    "img_5432.jpg",
    "img_5433.jpg",
    "img_5453.jpg",
    "img_5461.jpg",
    "img_5463.jpg",
    "img_5472.jpg",
    "img_5475.jpg",
    "img_5476.jpg",
    "img_5477.jpg",
    "img_5488.jpg",
    "img_5490.jpg",
].filter((name) => fs.existsSync(path.join(galleryDir, name)));

function jpegSize(filePath: string) {
    const buf = fs.readFileSync(filePath);
    let i = 2;
    while (i + 8 < buf.length) {
        if (buf[i] !== 0xff) {
            i += 1;
            continue;
        }
        const marker = buf[i + 1];
        const standalone =
            marker === 0xd8 ||
            marker === 0xd9 ||
            marker === 0x01 ||
            (marker >= 0xd0 && marker <= 0xd7);
        if (standalone) {
            i += 2;
            continue;
        }
        const length = buf.readUInt16BE(i + 2);
        if (marker >= 0xc0 && marker <= 0xc3) {
            return {
                h: buf.readUInt16BE(i + 5),
                w: buf.readUInt16BE(i + 7),
            };
        }
        i += 2 + length;
    }
    return { w: 3, h: 2 };
}

const galleryPhotos = gallery.map((name) => ({
    name,
    ...jpegSize(path.join(galleryDir, name)),
}));
