            </dialog>
            <script is:inline>
                (function () {
                    var gallery = document.querySelector("[data-mosaic]");
                    if (!gallery) return;
                    var gap = 8;
                    function layout() {
                        var items = Array.prototype.slice.call(gallery.children);
                        var width = gallery.clientWidth;
                        if (!width) return;
                        var target =
                            width < 720 ? 148 : width < 1100 ? 188 : 216;
                        var row = [];
                        var aspectSum = 0;
                        function place(isLast) {
                            if (!row.length) return;
                            var gaps = gap * (row.length - 1);
                            var height = (width - gaps) / aspectSum;
                            if (isLast && height > target * 1.35) height = target;
                            var used = 0;
                            row.forEach(function (item, index) {
                                var w =
                                    !isLast && index === row.length - 1
                                        ? width - gaps - used
                                        : Math.max(1, Math.round(item.aspect * height));
                                used += w;
                                item.li.style.width = w + "px";
                            });
                            row = [];
                            aspectSum = 0;
                        }
                        items.forEach(function (li) {
                            var aspect =
                                Number(li.getAttribute("data-w")) /
                                Number(li.getAttribute("data-h"));
                            if (!aspect || aspect < 0.2 || aspect > 5) aspect = 1.5;
                            var count = row.length + 1;
                            var needed =
                                (aspectSum + aspect) * target + gap * (count - 1);
                            if (row.length && needed > width) place(false);
                            row.push({ li: li, aspect: aspect });
                            aspectSum += aspect;
                        });
                        place(true);
                    }
                    layout();
                    window.addEventListener("resize", layout);
                    window.addEventListener("load", layout);

                    var dialog = document.querySelector("[data-lightbox]");
                    var frame = dialog.querySelector("img");
                    gallery.addEventListener("click", function (event) {
                        var button = event.target.closest("[data-full]");
                        if (!button) return;
                        frame.src = button.getAttribute("data-full");
                        frame.alt = "Canada2080 kickoff photograph";
                        dialog.showModal();
                    });
                    dialog.addEventListener("click", function (event) {
                        if (
                            event.target === dialog ||
                            event.target.closest("[data-lightbox-close]")
                        ) {
                            dialog.close();
                        }
                    });
                })();
            </script>
        </section>
