---
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Canada2080 kickoff reminder card for Sunday, October 4, 2026. Speakers, panelists, and topics finalized."
    />
    <meta name="robots" content="noindex" />
    <title>Canada2080 kickoff reminder card</title>
  </head>
  <body>
    <main class="deck" aria-label="Canada2080 kickoff reminder card">
      <header class="deck-toolbar">
        <div class="deck-toolbar-copy">
          <p class="deck-toolbar-title">Canada2080 kickoff reminder</p>
          <p class="deck-toolbar-note">
            One 1080 × 1080 PNG for LinkedIn. Captions below for day-before and
            day-of.
          </p>
        </div>
        <a class="deck-locale-link" href="/events/2026-kickoff-reminder-zh"
          >中文版</a
        >
      </header>

      <figure class="card-figure">
        <div class="card-slot">
          <article
            class="card card-reminder"
            aria-labelledby="reminder-title"
            data-card-file="canada2080-kickoff-reminder.png"
          >
            <header class="reminder-brand">
              <img
                class="reminder-wordmark"
                src="/brand/2080-wordmark.svg"
                alt="Canada2080"
                width="894"
                height="221"
              />
              <p class="reminder-kicker">Programme finalized</p>
            </header>

            <div class="reminder-intro">
              <div class="signal-rule" aria-hidden="true"></div>
              <h1 id="reminder-title">Join the founding conversation.</h1>
              <p class="reminder-meta">
                Sunday, 4 October 2026 · Markham Ballroom · Hilton
                Toronto/Markham
              </p>
              <p class="reminder-meta reminder-meta-time">
                Guest arrival 12:30 p.m. · Programme 1:00 p.m. · In person and
                online
              </p>
            </div>

            <div class="reminder-panels">
              <section class="panel-block" aria-labelledby="panel-1-title">
                <p class="panel-index">Panel 1</p>
                <h2 id="panel-1-title">
                  Sovereign AI, Data Governance, and Trustworthy Deployment
                </h2>
                <ul class="contributor-list">
                  <li>
                    Dr Sudarshana Bhattacharya
                    <span class="role-tag">Keynote · Panelist</span>
                  </li>
                  <li>
                    Dr Kimberly Yazzie
                    <span class="role-tag">Keynote · Panelist</span>
                  </li>
                  <li>
                    Erin Trochim
                    <span class="role-tag">Keynote · Panelist</span>
                  </li>
                  <li>
                    Sunita Kumari
                    <span class="role-tag">Keynote</span>
                  </li>
                  <li>
                    Pyn Lim
                    <span class="role-tag">Keynote · Panelist</span>
                  </li>
                </ul>
              </section>

              <section class="panel-block" aria-labelledby="panel-2-title">
                <p class="panel-index">Panel 2</p>
                <h2 id="panel-2-title">
                  Building National Capacity: Infrastructure, Risk Appetite,
                  and Domestic Scale-Up
                </h2>
                <ul class="contributor-list">
                  <li>
                    Barry Wylant
                    <span class="role-tag">Keynote</span>
                  </li>
                  <li>
                    Yulia Korobkova
                    <span class="role-tag">Keynote · Panelist</span>
                  </li>
                  <li>
                    Greg Hart
                    <span class="role-tag">Keynote · Panelist</span>
                  </li>
                  <li>
                    Dr Michael Donaldson
                    <span class="role-tag">Keynote · Panelist</span>
                  </li>
                  <li>
                    Sebastien Gendron
                    <span class="role-tag">Keynote · Panelist</span>
                  </li>
                </ul>
              </section>
            </div>

            <footer class="reminder-footer">
              <div class="reminder-rsvp-copy">
                <p class="reminder-rsvp-label">RSVP</p>
                <p class="reminder-rsvp-url">luma.com/w7g9hjb7</p>
                <p class="reminder-site">canada2080.org</p>
              </div>
              <img
                class="reminder-qr"
                src="/images/canada2080-kickoff-rsvp-qr.png"
                alt="QR code linking to the Canada2080 kickoff RSVP on Luma"
                width="440"
                height="440"
              />
            </footer>
          </article>
        </div>
        <figcaption class="card-actions">
          <span class="card-label">Reminder · EN</span>
          <button type="button" class="card-download" data-download-card>
            Download PNG
          </button>
        </figcaption>
      </figure>

      <section class="captions" aria-label="LinkedIn reminder captions">
        <header class="captions-header">
          <h2>LinkedIn captions</h2>
          <p>Copy for reshare. Same image for both posts.</p>
        </header>

        <article class="caption-block">
          <div class="caption-block-head">
            <h3>Day before</h3>
            <button type="button" class="caption-copy" data-copy-caption>
              Copy
            </button>
          </div>
          <pre class="caption-text" data-caption-text>Tomorrow, Canada2080 kicks off in Markham.

Speakers, panelists, and discussion topics are finalized.

Panel 1 — Sovereign AI, Data Governance, and Trustworthy Deployment
Panel 2 — Building National Capacity: Infrastructure, Risk Appetite, and Domestic Scale-Up

Sunday, 4 October 2026
Markham Ballroom · Hilton Toronto/Markham
Guest arrival 12:30 p.m. · Programme begins 1:00 p.m.
In person and online.

RSVP: https://luma.com/w7g9hjb7
Event: https://canada2080.org/events/2026-kickoff

#canada2080</pre>
        </article>

        <article class="caption-block">
          <div class="caption-block-head">
            <h3>Day of · morning</h3>
            <button type="button" class="caption-copy" data-copy-caption>
              Copy
            </button>
          </div>
          <pre class="caption-text" data-caption-text>Today, Canada2080 kicks off in Markham.

Speakers, panelists, and discussion topics are finalized. Doors open at 12:30 p.m.; the programme begins at 1:00 p.m.

Panel 1 — Sovereign AI, Data Governance, and Trustworthy Deployment
Panel 2 — Building National Capacity: Infrastructure, Risk Appetite, and Domestic Scale-Up

Markham Ballroom · Hilton Toronto/Markham
In person and online.

RSVP: https://luma.com/w7g9hjb7
Event: https://canada2080.org/events/2026-kickoff

#canada2080</pre>
        </article>
      </section>
    </main>

    <script>
      import { bindCardExportControls } from "../../lib/export-card-image";

      bindCardExportControls({
        preparing: "Preparing…",
        retry: "Try again",
        idleOne: "Download PNG",
      });

      document
        .querySelectorAll<HTMLButtonElement>("[data-copy-caption]")
        .forEach((button) => {
          button.addEventListener("click", async () => {
            const block = button.closest(".caption-block");
            const text = block?.querySelector<HTMLElement>(
              "[data-caption-text]",
            )?.textContent;
            if (!text) return;
            const idle = "Copy";
            try {
              await navigator.clipboard.writeText(text);
              button.textContent = "Copied";
            } catch {
              button.textContent = "Select text";
            }
            window.setTimeout(() => {
              button.textContent = idle;
            }, 1600);
          });
        });
    </script>
  </body>
</html>

<style is:global>
  @page {
    size: 1080px 1080px;
    margin: 0;
  }

  :root {
    --signal: #f02e23;
    --ink: #071f26;
    --snow: #f5f4ef;
    --lake: #8fa6ad;
    --display: "Arial Black", "Helvetica Neue", Arial, sans-serif;
    --body: Arial, "Helvetica Neue", sans-serif;
    --mono: ui-monospace, SFMono-Regular, Consolas, monospace;
    --card-size: 1080px;
    --preview-size: min(720px, calc(100vw - 2rem));
    --preview-scale: calc(var(--preview-size) / var(--card-size));
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
  }

  body {
    background: #d8e0e1;
    color: var(--ink);
    font-family: var(--body);
  }

  .deck {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    justify-content: center;
    padding: clamp(1rem, 3vw, 2.5rem) 1rem 3rem;
  }

  .deck-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    width: var(--preview-size);
  }

  .deck-toolbar-title {
    margin: 0 0 0.25rem;
    font: 900 1.15rem/1.2 var(--display);
    letter-spacing: -0.03em;
  }

  .deck-toolbar-note {
    margin: 0;
    color: #496069;
    font: 600 0.92rem/1.35 var(--body);
  }

  .deck-locale-link,
  .card-download,
  .caption-copy {
    appearance: none;
    border: 1px solid var(--ink);
    background: var(--snow);
    color: var(--ink);
    cursor: pointer;
    font: 700 0.82rem/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.85rem 1rem;
    text-decoration: none;
  }

  .deck-locale-link:hover,
  .card-download:hover,
  .caption-copy:hover {
    background: var(--ink);
    color: var(--snow);
  }

  .card-download:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .card-figure {
    display: grid;
    gap: 0.75rem;
    width: var(--preview-size);
    margin: 0;
  }

  .card-slot {
    width: 100%;
    height: var(--preview-size);
    overflow: hidden;
    box-shadow: 0 1rem 2.5rem rgb(7 31 38 / 16%);
  }

  .card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-label {
    color: #496069;
    font: 700 0.78rem/1.2 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card {
    width: var(--card-size);
    height: var(--card-size);
    padding: 52px 56px 48px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(var(--preview-scale));
    transform-origin: top left;
  }

  .card-reminder {
    color: var(--snow);
    background: var(--ink);
  }

  .reminder-brand {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .reminder-wordmark {
    display: block;
    width: 420px;
    height: auto;
  }

  .reminder-kicker {
    margin: 0.35rem 0 0;
    color: var(--signal);
    font: 700 18px/1.2 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: right;
  }

  .reminder-intro {
    margin-top: 28px;
    flex-shrink: 0;
  }

  .signal-rule {
    width: 56px;
    height: 4px;
    margin-bottom: 18px;
    background: var(--signal);
  }

  .reminder-intro h1 {
    margin: 0 0 14px;
    font: 900 42px/1.05 var(--display);
    letter-spacing: -0.03em;
    max-width: 920px;
  }

  .reminder-meta {
    margin: 0;
    color: var(--lake);
    font: 600 20px/1.35 var(--body);
  }

  .reminder-meta-time {
    margin-top: 4px;
  }

  .reminder-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 28px;
    flex: 1;
    min-height: 0;
  }

  .panel-block {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding-top: 14px;
    border-top: 4px solid var(--signal);
  }

  .panel-index {
    margin: 0 0 8px;
    color: var(--signal);
    font: 700 15px/1.2 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .panel-block h2 {
    margin: 0 0 16px;
    font: 800 24px/1.2 var(--display);
    letter-spacing: -0.02em;
  }

  .contributor-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }

  .contributor-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    font: 600 20px/1.25 var(--body);
  }

  .role-tag {
    color: var(--lake);
    font: 700 12px/1.2 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .reminder-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid rgb(245 244 239 / 18%);
    flex-shrink: 0;
  }

  .reminder-rsvp-label {
    margin: 0 0 6px;
    color: var(--signal);
    font: 700 14px/1.2 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .reminder-rsvp-url {
    margin: 0;
    font: 800 28px/1.1 var(--display);
    letter-spacing: -0.02em;
  }

  .reminder-site {
    margin: 8px 0 0;
    color: var(--lake);
    font: 600 18px/1.2 var(--body);
  }

  .reminder-qr {
    display: block;
    width: 118px;
    height: 118px;
    object-fit: contain;
    background: var(--snow);
    padding: 6px;
  }

  .captions {
    width: min(720px, calc(100vw - 2rem));
    display: grid;
    gap: 1rem;
  }

  .captions-header h2 {
    margin: 0 0 0.25rem;
    font: 900 1.1rem/1.2 var(--display);
    letter-spacing: -0.02em;
  }

  .captions-header p {
    margin: 0;
    color: #496069;
    font: 600 0.92rem/1.35 var(--body);
  }

  .caption-block {
    background: var(--snow);
    border: 1px solid rgb(7 31 38 / 14%);
    padding: 1rem;
  }

  .caption-block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .caption-block-head h3 {
    margin: 0;
    font: 800 0.95rem/1.2 var(--display);
  }

  .caption-text {
    margin: 0;
    white-space: pre-wrap;
    font: 500 0.92rem/1.45 var(--body);
    color: var(--ink);
  }
</style>
