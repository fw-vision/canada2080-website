---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TripartiteEcosystem from "../../components/TripartiteEcosystem.astro";
import YearWordmark from "../../components/YearWordmark.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    entry: CollectionEntry<"events">;
}

export async function getStaticPaths() {
    const entries = await getCollection("events", ({ data }) => !data.draft);
    return entries.map((entry) => ({
        params: { slug: entry.id.replace(/\.md$/, "") },
        props: { entry },
    }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const statusLabel = entry.data.status.replaceAll("-", " ");
const eventTitle = entry.data.title.replace(/^Canada2080:\s*/, "");
const guestGroups = [
    { id: "governance", title: "Public leaders and public servants" },
    { id: "academic", title: "Academic and research leaders" },
    {
        id: "industry",
        title: "Industry, infrastructure, and innovation leaders",
    },
] as const;
---

<BaseLayout
    title={`${entry.data.title} | Canada2080`}
    description={entry.data.description}
>
    <article>
        <header class="event-hero page-hero-dark">
            <div class="shell event-hero-grid">
                <div>
                    <p class="eyebrow">
                        {entry.data.dateLabel} / {statusLabel}
                    </p>
                    <h1 class="event-title">
                        <span class="sr-only">Canada2080: </span>
                        <span class="event-title-wordmark" aria-hidden="true">
                            <YearWordmark tone="inverse" />
                        </span>
                        <span class="event-title-text">{eventTitle}</span>
                    </h1>
                    <p>{entry.data.description}</p>
                </div>
                <dl class="event-facts">
                    <div>
                        <dt>Date</dt>
                        <dd>{entry.data.dateLabel}</dd>
                    </div>
                    {entry.data.candidateDates.length > 0 && (
                        <div>
                            <dt>Considering</dt>
                            <dd>{entry.data.candidateDates.join(" or ")}</dd>
                        </div>
                    )}
                    <div>
                        <dt>Format</dt>
                        <dd>{entry.data.format}</dd>
                    </div>
                    <div>
                        <dt>Duration</dt>
                        <dd>{entry.data.duration}</dd>
                    </div>
                    {entry.data.time && (
                        <div>
                            <dt>Time</dt>
                            <dd>{entry.data.time}</dd>
                        </div>
                    )}
                    {entry.data.location && (
                        <div>
                            <dt>Location</dt>
                            <dd>{entry.data.location}</dd>
                        </div>
                    )}
                </dl>
            </div>
        </header>

        <section class="section shell">
            <TripartiteEcosystem />
        </section>

        <section class="section shell event-body">
            <div class="article-body">
                <Content />
            </div>
        </section>

        <section class="section section-horizon">
            <div class="shell">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">140-minute format</p>
                        <h2>
                            An 80-minute programme between two periods of
                            connection.
                        </h2>
                    </div>
                    <p>
                        The programme sequence is set at 80 minutes. The
                        possible panel, exact start time, and private logistics
                        will be finalized after availability and participation
                        are confirmed.
                    </p>
                </div>
                <ol class="event-itinerary">
                    {entry.data.itinerary.map((item) => (
                        <li>
                            <span>{item.time}</span>
                            <h3>{item.title}</h3>
                            <p>{item.duration}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <section class="section shell">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Invited guests</p>
                    <h2>People across the innovation ecosystem.</h2>
                </div>
                <p>
                    The list brings public, academic, research, and industry
                    experience into one room. An invitation or attendance does
                    not imply endorsement or a speaking role. Guest details and
                    programme roles remain subject to direct confirmation unless
                    noted as remote.
                </p>
            </div>
            <div class="guest-groups">
                {guestGroups.map((group) => {
                    const guests = entry.data.guests.filter(
                        (guest) => guest.group === group.id,
                    );
                    return (
                        guests.length > 0 && (
                            <section
                                class="guest-group"
                                aria-labelledby={`guest-group-${group.id}`}
                            >
                                <h3 id={`guest-group-${group.id}`}>
                                    {group.title}
                                </h3>
                                <ol class="guest-list">
                                    {guests.map((guest) => (
                                        <li>
                                            <div class="guest-name-row">
                                                <h4>{guest.name}</h4>
                                                {guest.participation ===
                                                    "remote" && (
                                                    <span class="guest-participation">
                                                        Joining remotely
                                                    </span>
                                                )}
                                            </div>
                                            <p class="guest-institution">
                                                {guest.institution}
                                            </p>
                                            <p>
                                                <strong>
                                                    {guest.expertise}
                                                </strong>
                                            </p>
                                            <p>{guest.bio}</p>
                                        </li>
                                    ))}
                                </ol>
                            </section>
                        )
                    );
                })}
            </div>
        </section>

        <section class="section section-signal">
            <div class="shell statement-section">
                <div>
                    <p class="eyebrow">Participation and contribution</p>
                </div>
                <div>
                    <h2>Join the founding conversation.</h2>
                    <p class="lead">
                        Guests may indicate whether they prefer to join in
                        person or online, share final-time constraints, and
                        express interest in a short perspective, discussion, or
                        recorded message.
                    </p>
                    <div class="action-row">
                        <a
                            class="event-invitation-cta"
                            href="/events/2026-kickoff-programinfo"
                        >
                            View invitation cards
                        </a>
                        <a class="text-link text-link-light" href="/join">
                            Find your role
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </article>
</BaseLayout>
