---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TripartiteEcosystem from "../../components/TripartiteEcosystem.astro";
import YearWordmark from "../../components/YearWordmark.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
    entry: CollectionEntry<"events">;
}

export async function getStaticPaths() {
    const entries = await getCollection("events", ({ data }) => !data.draft);
    return entries.map((entry) => ({
        params: { slug: entry.id.replace(/\.md$/, "") },
        props: { entry },
    }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const statusLabel = entry.data.status.replaceAll("-", " ");
const eventTitle = entry.data.title.replace(/^Canada2080:\s*/, "");
const guestGroups = [
    { id: "governance", sphere: "Governance:", title: "Municipal leaders" },
    { id: "academic", sphere: "Education:", title: "Academic and research leaders" },
    {
        id: "industry",
        sphere: "Industry:",
        title: "Infrastructure and innovation leaders",
    },
] as const;
const participationLabels = {
    invited: "Invited",
    remote: "Remote",
    "in-person": "In-person",
} as const;
const confirmedGuests = entry.data.guests.filter(
    (guest) => guest.listing === "featured",
);
const invitedGuests = entry.data.guests.filter(
    (guest) => guest.listing === "invited",
);
---

<BaseLayout
    title={`${entry.data.title} | Canada2080`}
    description={entry.data.description}
>
    <article>
        <header class="event-hero page-hero-dark">
            <div class="shell event-hero-grid">
                <div>
                    <p class="eyebrow">
                        {entry.data.dateLabel} / {statusLabel}
                    </p>
                    <h1 class="event-title">
                        <span class="sr-only">Canada2080: </span>
                        <span class="event-title-wordmark" aria-hidden="true">
                            <YearWordmark tone="inverse" />
                        </span>
                        <span class="event-title-text">{eventTitle}</span>
                    </h1>
                    <p>{entry.data.description}</p>
                    {entry.data.rsvp && (
                        <div class="action-row">
                            <a
                                class="button button-signal"
                                href={entry.data.rsvp}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                RSVP on Luma
                            </a>
                        </div>
                    )}
                </div>
                <dl class="event-facts">
                    <div>
                        <dt>Date</dt>
                        <dd>{entry.data.dateLabel}</dd>
                    </div>
                    {entry.data.candidateDates.length > 0 && (
                        <div>
                            <dt>Considering</dt>
                            <dd>{entry.data.candidateDates.join(" or ")}</dd>
                        </div>
                    )}
                    <div>
                        <dt>Format</dt>
                        <dd>{entry.data.format}</dd>
                    </div>
                    <div>
                        <dt>Duration</dt>
                        <dd>{entry.data.duration}</dd>
                    </div>
                    {entry.data.time && (
                        <div>
                            <dt>Time</dt>
                            <dd>
                                {entry.data.arrivalTime && (
                                    <span>{entry.data.arrivalTime}</span>
                                )}
                                {entry.data.programmeTime && (
                                    <span>{entry.data.programmeTime}</span>
                                )}
                                {!entry.data.arrivalTime &&
                                    !entry.data.programmeTime && (
                                        <span>{entry.data.time}</span>
                                    )}
                            </dd>
                        </div>
                    )}
                    {entry.data.onlineAttendance && (
                        <div>
                            <dt>Remote</dt>
                            <dd>{entry.data.onlineAttendance}</dd>
                        </div>
                    )}
                    {entry.data.location && (
                        <div>
                            <dt>Location</dt>
                            <dd>
                                <span>{entry.data.location}</span>
                                {entry.data.locationAddress && (
                                    <span class="event-address">
                                        {entry.data.locationAddress}
                                    </span>
                                )}
                                {entry.data.mapUrl && (
                                    <a
                                        class="event-map-link"
                                        href={entry.data.mapUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Open in Google Maps
                                    </a>
                                )}
                            </dd>
                        </div>
                    )}
                </dl>
            </div>
        </header>

        <section class="section shell">
            <TripartiteEcosystem />
        </section>

        <section class="section shell event-body">
            <div class="article-body">
                <Content />
            </div>
        </section>

        <section class="section section-horizon">
            <div class="shell">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">150-minute format</p>
                        <h2>
                            A 90-minute programme between two periods of
                            connection.
                        </h2>
                    </div>
                    <p>
                        Guest arrival begins at 12:30 p.m., and the
                        programme begins at 1:00 p.m. sharp. Two invited-speaker
                        sections and two 15-minute panels lead to a five-minute
                        closing synthesis at 2:25 p.m.
                    </p>
                </div>
                <ol class="event-itinerary">
                    {entry.data.itinerary.map((item) => (
                        <li>
                            <span>{item.time}</span>
                            <div>
                                <h3>{item.title}</h3>
                                {item.description && (
                                    <p class="event-itinerary-description">
                                        {item.description}
                                    </p>
                                )}
                            </div>
                            <p>{item.duration}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <section class="section shell guest-section" id="invited-guests">
            <div class="section-heading">
                <div>
                    <div class="section-anchor-heading">
                        <p class="eyebrow">Invited guests</p>
                        <a
                            class="section-anchor-link"
                            href="#invited-guests"
                            aria-label="Link to invited guests"
                            title="Link to invited guests"
                        >
                            <svg
                                viewBox="0 0 24 24"
                                width="18"
                                height="18"
                                aria-hidden="true"
                            >
                                <path
                                    d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                                ></path>
                            </svg>
                        </a>
                    </div>
                    <h2>Governance, education, and industry in one room.</h2>
                </div>
                <p>
                    The Tripartite Ecosystem brings Governance, Education, and
                    Industry into one conversation. An invitation or attendance does
                    not imply endorsement or a speaking role. Guest details and
                    programme roles remain subject to direct confirmation. Attendance
                    format is shown for confirmed contributors.
                </p>
            </div>
            <div class="guest-groups">
                {guestGroups.map((group) => {
                    const guests = confirmedGuests.filter(
                        (guest) => guest.group === group.id,
                    );
                    return (
                        guests.length > 0 && (
                            <section
                                class="guest-group"
                                aria-labelledby={`guest-group-${group.id}`}
                            >
                                <h3 id={`guest-group-${group.id}`}>
                                    {group.sphere}<br />
                                    {group.title}
                                </h3>
                                <ol class="guest-list">
                                    {guests.map((guest) => (
                                        <li>
                                            <div class="guest-name-row">
                                                <h4>
                                                    <a
                                                        href={guest.profileUrl}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                    >
                                                        {guest.name}
                                                    </a>
                                                </h4>
                                                <span
                                                    class:list={[
                                                        "guest-participation",
                                                        `guest-participation-${guest.participation}`,
                                                    ]}
                                                >
                                                    {participationLabels[guest.participation]}
                                                </span>
                                            </div>
                                            <p class="guest-institution">
                                                {guest.institution}
                                            </p>
                                            <p>
                                                <strong>
                                                    {guest.expertise}
                                                </strong>
                                            </p>
                                            <p>{guest.bio}</p>
                                            <a
                                                class="guest-profile-link"
                                                href={guest.profileUrl}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                View profile
                                            </a>
                                        </li>
                                    ))}
                                </ol>
                            </section>
                        )
                    );
                })}
            </div>
            {invitedGuests.length > 0 && (
                <section class="guest-invited" aria-labelledby="guest-invited-title">
                    <div class="guest-invited-heading">
                        <p class="eyebrow">Invited</p>
                        <h3 id="guest-invited-title">Additional ecosystem guests.</h3>
                    </div>
                    <ol class="guest-list guest-list-invited">
                        {invitedGuests.map((guest) => (
                            <li>
                                <div class="guest-name-row">
                                    <h4>
                                        <a
                                            href={guest.profileUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {guest.name}
                                        </a>
                                    </h4>
                                    <span class="guest-participation guest-participation-invited">
                                        {participationLabels.invited}
                                    </span>
                                </div>
                                <p class="guest-institution">{guest.institution}</p>
                                <p>
                                    <strong>{guest.expertise}</strong>
                                </p>
                                <p>{guest.bio}</p>
                                <a
                                    class="guest-profile-link"
                                    href={guest.profileUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    View profile
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            )}
        </section>

        <section class="section section-signal">
            <div class="shell statement-section">
                <div>
                    <p class="eyebrow">Participation and contribution</p>
                </div>
                <div>
                    <h2>Join the founding conversation.</h2>
                    <p class="lead">
                        Guests may indicate whether they prefer to join in
                        person or online, and express interest in a short
                        perspective, discussion panel, or recorded message.
                    </p>
                    <div class="action-row">
                        <a
                            class="event-invitation-cta"
                            href="/events/2026-kickoff-programinfo"
                        >
                            View invitation cards
                        </a>
                        <a
                            class="event-invitation-cta"
                            href="/events/2026-kickoff-reminder"
                        >
                            View reminder card
                        </a>
                        <a class="text-link text-link-light" href="/join">
                            Find your role
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </article>
</BaseLayout>
