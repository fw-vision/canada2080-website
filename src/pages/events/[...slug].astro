---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'events'>; }

export async function getStaticPaths() {
  const entries = await getCollection('events', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id.replace(/\.md$/, '') }, props: { entry } }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const statusLabel = entry.data.status.replaceAll('-', ' ');
---

<BaseLayout title={`${entry.data.title} | Canada2080`} description={entry.data.description}>
  <article>
    <header class="event-hero page-hero-dark"><div class="shell event-hero-grid"><div><p class="eyebrow">{entry.data.dateLabel} / {statusLabel}</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div><dl class="event-facts"><div><dt>Date</dt><dd>{entry.data.dateLabel}</dd></div>{entry.data.candidateDates.length > 0 && <div><dt>Considering</dt><dd>{entry.data.candidateDates.join(' or ')}</dd></div>}<div><dt>Format</dt><dd>{entry.data.format}</dd></div><div><dt>Duration</dt><dd>{entry.data.duration}</dd></div>{entry.data.time && <div><dt>Time</dt><dd>{entry.data.time}</dd></div>}{entry.data.location && <div><dt>Location</dt><dd>{entry.data.location}</dd></div>}</dl></div></header>
    <section class="section shell event-body"><div class="article-body"><Content /></div></section>
    <section class="section section-horizon"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Two-hour format</p><h2>A focused hour of speaking between two periods of connection.</h2></div><p>The programme totals exactly 60 minutes. Final times and private logistics will follow after availability is reviewed.</p></div><ol class="event-itinerary">{entry.data.itinerary.map((item) => <li><span>{item.time}</span><h3>{item.title}</h3><p>{item.duration}</p></li>)}</ol></div></section>
    <section class="section shell"><div class="section-heading"><div><p class="eyebrow">Invited Speakers</p><h2>Short perspectives that test the work.</h2></div><p>Every person below is invited rather than confirmed. Invitation or later participation does not imply endorsement. Affiliations, biographies, remarks, photos, and remote arrangements will be confirmed directly.</p></div><ol class="speaker-list">{entry.data.speakers.map((speaker, index) => <li><span>0{index + 1}</span><div><h3>{speaker.name}</h3><p class="speaker-institution">{speaker.institution}</p><p><strong>{speaker.expertise}</strong></p><p>{speaker.bio}</p></div></li>)}</ol></section>
    <section class="section section-signal"><div class="shell statement-section"><div><p class="eyebrow">Availability first</p></div><div><h2>Help finalize the room and schedule.</h2><p class="lead">The first invitation wave will ask potential speakers and VIP guests whether October 3 or 4 works, which times they can accommodate, and how they might contribute.</p><a class="button button-dark" href="/join">Find your role</a></div></div></section>
  </article>
</BaseLayout>
