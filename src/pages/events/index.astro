---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

const events = (await getCollection('events', ({ data }) => !data.draft)).sort((a, b) => b.data.sortDate.getTime() - a.data.sortDate.getTime());
---

<BaseLayout title="Events | Canada2080" description="Canada2080 kickoffs, salons, working summits, conferences, and public records.">
  <section class="page-hero page-hero-dark"><div class="shell"><p class="eyebrow">Gatherings / Current and future</p><h1>Events that move the trajectory.</h1><p>Canada2080 convenes focused conversations around evidence, missions, roles, and public accountability.</p></div></section>
  <section class="section shell"><div class="section-heading"><div><p class="eyebrow">Current programme</p><h2>Begin with a public question. Leave with a possible role.</h2></div><p>The kickoff is Sunday, October 4, 2026, at the Hilton Toronto/Markham Suites Conference Centre & Spa, Markham Ballroom. In-person and online attendance are available. The final start time will be announced Sunday evening or Monday.</p></div><div class="content-grid content-grid-single">{events.map((event) => <ContentCard eyebrow={`${event.data.dateLabel} / ${event.data.status.replaceAll('-', ' ')}`} title={event.data.title} description={event.data.description} href={`/events/${event.id.replace(/\.md$/, '')}`} linkLabel="View the programme" />)}</div></section>
  <section class="section section-dark"><div class="shell statement-section"><div><p class="eyebrow">Beyond the kickoff</p></div><div><h2>A continuing convening platform.</h2><p class="lead">Future salons, working summits, field events, and conferences will connect mission questions to research, operating knowledge, finance, policy, and public evaluation.</p></div></div></section>
</BaseLayout>
