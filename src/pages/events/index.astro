---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

const events = (await getCollection('events', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Events | Canada2080" description="Canada2080 kickoffs, salons, working summits, conferences, and public records.">
  <section class="page-hero page-hero-dark"><div class="shell"><p class="eyebrow">Gatherings / Current and future</p><h1>Events that move the trajectory.</h1><p>Canada2080 convenes focused conversations around evidence, missions, commitments, and public accountability.</p></div></section>
  <section class="section shell"><div class="section-heading"><div><p class="eyebrow">Current programme</p><h2>Begin with a public question. Leave with an owner.</h2></div><p>Each event is designed to produce useful challenges, named next steps, and a record that can be checked.</p></div><div class="content-grid content-grid-single">{events.map((event) => <ContentCard eyebrow={`${event.data.date.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' })} / ${event.data.status}`} title={event.data.title} description={event.data.description} href={`/events/${event.id.replace(/\.md$/, '')}`} linkLabel="View the programme" />)}</div></section>
  <section class="section section-dark"><div class="shell statement-section"><div><p class="eyebrow">Beyond the kickoff</p></div><div><h2>A continuing convening platform.</h2><p class="lead">Future salons, working summits, field events, and conferences will connect regional missions to research, operating knowledge, finance, policy, and public evaluation.</p></div></div></section>
</BaseLayout>
