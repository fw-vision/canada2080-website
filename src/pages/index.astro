---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import EvidenceLabel from '../components/EvidenceLabel.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import TrajectoryTimeline from '../components/TrajectoryTimeline.astro';
import { fiveGaps, missions } from '../data/site';

const research = (await getCollection('research', ({ data }) => data.status === 'published' && !data.draft))[0];
const journal = (await getCollection('journal', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];
---

<BaseLayout
  title="Canada2080 | Build what the future requires"
  description="Canada2080 develops the evidence, missions, and coalitions for Canada to become a major economic power by 2080, with the capability to surpass the United States through sovereign industry and public value."
>
  <HeroShowcase
    headline="Build what the future requires."
    deck="By 2080, Canada can become one of the world's major economic powers, with the capability to surpass the United States through sovereign industry, research, capital, and public value built at home."
    primaryHref="/trajectory"
    primaryLabel="Explore the trajectory"
    secondaryHref="/events/2026-kickoff"
    secondaryLabel="September 28 kickoff"
  />

  <section class="section shell statement-section" aria-labelledby="ambition-title">
    <div>
      <p class="eyebrow">The ambition</p>
      <EvidenceLabel label="Aspiration" />
    </div>
    <div>
      <h2 id="ambition-title">A country with the capability to choose its future.</h2>
      <p class="lead">By 2080, Canada can become an economically sovereign major power whose strategic capabilities are researched, financed, governed, operated, repaired, and renewed through Canadian institutions, with the capability to surpass the United States in the arenas Canada chooses to lead.</p>
    </div>
  </section>

  <section id="five-gaps" class="section shell" aria-labelledby="gaps-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The problem spine</p>
        <h2 id="gaps-title">Five gaps between knowledge and capability.</h2>
      </div>
      <p>Francis Wang first formulated the Five Canadian Systemic Gaps in his 2025 DDes research proposal, <em>Foresight-Driven Innovation</em>. Together they describe a conversion-and-control problem.</p>
    </div>
    <ol class="gap-list">
      {fiveGaps.map((gap) => (
        <li>
          <span class="gap-number">{gap.number}</span>
          <div><h3>{gap.title}</h3><p>{gap.summary}</p></div>
          <EvidenceLabel label={gap.evidenceClass} />
        </li>
      ))}
    </ol>
    <a class="button button-outline" href="/five-gaps">Study the Five Gaps</a>
  </section>

  <section class="section section-horizon" aria-labelledby="trajectory-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The preferred trajectory</p>
          <h2 id="trajectory-title">Establish. Demonstrate. Compound. Lead. Renew.</h2>
        </div>
        <p>Canada2080 links present actions to gates that can be measured and revised across five horizons.</p>
      </div>
      <TrajectoryTimeline />
      <a class="button button-dark" href="/trajectory">See the path and offramps</a>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="missions-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Six mission fields</p>
          <h2 id="missions-title">Regional delivery. National capability.</h2>
        </div>
        <p>Each mission connects evidence, rights, demand, infrastructure, long-horizon capital, skilled work, and public accountability.</p>
      </div>
      <ol class="mission-grid">
        {missions.map(([number, title, summary]) => (
          <li><span>{number}</span><h3>{title}</h3><p>{summary}</p></li>
        ))}
      </ol>
      <a class="button button-light" href="/missions">Explore the missions</a>
    </div>
  </section>

  <section class="section shell event-feature" aria-labelledby="event-title">
    <div class="event-date" aria-hidden="true"><span>SEP</span><strong>28</strong><span>2026</span></div>
    <div>
      <p class="eyebrow">Featured gathering</p>
      <h2 id="event-title">The capability we choose to build.</h2>
      <p class="lead">An invitation-only kickoff release and founding conversation with networking, a focused 60-minute programme, independent academic perspectives, and commitment-focused follow-up.</p>
      <p>Private time, venue, accessibility, and arrival details will be issued directly to confirmed guests when finalised.</p>
      <a class="button button-signal" href="/events/2026-kickoff">View the programme</a>
    </div>
  </section>

  <section class="section shell" aria-labelledby="record-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The public record</p>
        <h2 id="record-title">Evidence people can inspect. Progress people can check.</h2>
      </div>
      <p>Research carries visible evidence classes. The journal records events, interpretations, corrections, reflections, and accountability.</p>
    </div>
    <div class="content-grid">
      {research && <ContentCard eyebrow={`Research / ${research.data.evidenceClass}`} title={research.data.title} description={research.data.description} href={`/research/${research.id.replace(/\.md$/, '')}`} linkLabel="Read the research" />}
      {journal && <ContentCard eyebrow="Journal / Announcement" title={journal.data.title} description={journal.data.description} href={`/journal/${journal.id.replace(/\.md$/, '')}`} linkLabel="Read the journal" />}
    </div>
  </section>

  <section class="section section-signal" aria-labelledby="join-title">
    <div class="shell statement-section">
      <div><p class="eyebrow">The invitation</p></div>
      <div>
        <h2 id="join-title">Choose one capability Canada must build and renew.</h2>
        <p class="lead">Contribute evidence, capital, institutional capacity, policy action, operating knowledge, regional leadership, or independent evaluation.</p>
        <a class="button button-dark" href="/join">Find your role</a>
      </div>
    </div>
  </section>
</BaseLayout>
